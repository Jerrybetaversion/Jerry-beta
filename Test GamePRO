-- Haupt-Render-Loop
local lastTriggerShot = 0
local orbitAngle = 0

TrackConn(RunService.RenderStepped:Connect(function(dt)
	-- Crosshair Rotation
	if State.CustomCrosshair and State.CrosshairSpin then
		crosshairHolder.Rotation = (crosshairHolder.Rotation + 160 * dt) % 360
	end

	local closestTarget = getClosestTargetInFOV()

	-- Target-Info-HUD
	if State.TargetHUD and closestTarget and not State.Streamproof then
		targetHud.Visible = true
		local hum = closestTarget.Hum
		local dist = CachedRoot and math.floor((closestTarget.Part.Position - CachedRoot.Position).Magnitude) or 0
		thName.Text = "🎯 " .. closestTarget.Data.Name
		thSub.Text = string.format("%d / %d HP • %d Studs", math.floor(hum.Health), math.floor(hum.MaxHealth), dist)
		thBarFill.Size = UDim2.new(math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1), 0, 1, 0)
	else
		targetHud.Visible = false
	end

	-- Aim-Assist [RMB]
	if State.AimAssist and closestTarget and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
		local goalCFrame = CFrame.lookAt(camera.CFrame.Position, closestTarget.Part.Position)
		local alpha = math.clamp(State.AimSmoothness / 100, 0.05, 1)
		camera.CFrame = camera.CFrame:Lerp(goalCFrame, alpha)
	end

	-- Triggerbot
	if State.Triggerbot and mouse.Target and (os.clock() - lastTriggerShot > 0.12) then
		for _, t in ipairs(GetCombatTargets()) do
			if mouse.Target:IsDescendantOf(t.Char) then
				lastTriggerShot = os.clock()
				VirtualUser:Button1Down(Vector2.zero, camera.CFrame)
				task.delay(0.02, function() VirtualUser:Button1Up(Vector2.zero, camera.CFrame) end)
				break
			end
		end
	end

	-- 2D-Tracers & 2D-Radar
	tracerContainer:ClearAllChildren()
	radarDotsFolder:ClearAllChildren()
	if (State.ESPTracers or State.ShowRadar) and not State.Streamproof then
		local vp = camera.ViewportSize
		local start2D = Vector2.new(vp.X / 2, vp.Y - 10)

		for _, t in ipairs(GetCombatTargets()) do
			local hrp = t.Char:FindFirstChild("HumanoidRootPart")
			local hum = t.Char:FindFirstChildOfClass("Humanoid")
			if hrp and hum and hum.Health > 0 then
				if State.ESPTracers then
					local screenPos, onScreen = camera:WorldToViewportPoint(hrp.Position)
					if onScreen then
						local end2D = Vector2.new(screenPos.X, screenPos.Y)
						local diff = end2D - start2D
						local line = Instance.new("Frame", tracerContainer)
						line.AnchorPoint = Vector2.new(0.5, 0.5)
						line.Position = UDim2.new(0, (start2D.X + end2D.X) / 2, 0, (start2D.Y + end2D.Y) / 2)
						line.Size = UDim2.new(0, diff.Magnitude, 0, 1.5)
						line.Rotation = math.deg(math.atan2(diff.Y, diff.X))
						line.BackgroundColor3 = t.Color
						line.BorderSizePixel = 0
					end
				end

				if State.ShowRadar and CachedRoot then
					local rel = camera.CFrame:PointToObjectSpace(hrp.Position)
					local rx = math.clamp(rel.X / 120, -0.46, 0.46)
					local rz = math.clamp(rel.Z / 120, -0.46, 0.46)
					local dot = Instance.new("Frame", radarDotsFolder)
					dot.Size = UDim2.new(0, 6, 0, 6)
					dot.AnchorPoint = Vector2.new(0.5, 0.5)
					dot.Position = UDim2.new(0.5 + rx, 0, 0.5 + rz, 0)
					dot.BackgroundColor3 = t.Color
					corner(dot, 3)
				end
			end
		end
	end

	-- Mouse-Part-Inspector [Strg + Alt]
	if State.PartInspector and UserInputService:IsKeyDown(Enum.KeyCode.LeftAlt) and UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) and mouse.Target then
		local t = mouse.Target
		local mPos = UserInputService:GetMouseLocation()
		inspectorCard.Visible = true
		inspectorCard.Position = UDim2.new(0, mPos.X + 16, 0, mPos.Y + 16)
		inspectorLbl.Text = string.format(
			"Name: %s\nClass: %s | Mat: %s\nSize: %.1f, %.1f, %.1f\nCollide: %s | Transp: %.2f",
			t.Name, t.ClassName, t.Material.Name,
			t.Size.X, t.Size.Y, t.Size.Z,
			tostring(t.CanCollide), t.Transparency
		)
	else
		inspectorCard.Visible = false
	end

	-- True Freecam Steuerung
	if State.Freecam then
		local moveVec = Vector3.zero
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveVec += camera.CFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveVec -= camera.CFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveVec -= camera.CFrame.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveVec += camera.CFrame.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveVec += Vector3.new(0, 1, 0) end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveVec -= Vector3.new(0, 1, 0) end
		freecamCF = CFrame.lookAt(freecamCF.Position + (moveVec * State.FreecamSpeed * dt), freecamCF.Position + (moveVec * State.FreecamSpeed * dt) + camera.CFrame.LookVector)
		camera.CFrame = freecamCF
		return
	end

	if not (CachedHum and CachedRoot) then return end

	-- Anti-Void Sicherheitssystem
	if CachedHum.FloorMaterial ~= Enum.Material.Air then
		State.SafeGroundPos = CachedRoot.CFrame
	elseif State.AntiVoid and CachedRoot.Position.Y < -55 and State.SafeGroundPos then
		CachedRoot.AssemblyLinearVelocity = Vector3.zero
		CachedRoot.CFrame = State.SafeGroundPos + Vector3.new(0, 4, 0)
		Notify("Anti-Void", "Vor dem Abgrund gerettet!", "Warn")
	end

	-- Player & Troll Hub Bewegungen (Orbit, Backpack, Head-Sit, Spin-Fling)
	local targetRoot = getTargetRoot()
	if targetRoot then
		if State.OrbitTarget then
			orbitAngle += dt * State.OrbitSpeed
			local offset = Vector3.new(math.cos(orbitAngle) * State.OrbitRadius, 1, math.sin(orbitAngle) * State.OrbitRadius)
			CachedRoot.CFrame = CFrame.lookAt(targetRoot.Position + offset, targetRoot.Position)
		elseif State.BackpackAttach then
			CachedRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 1.65)
		elseif State.HeadSit then
			CachedHum.Sit = true
			CachedRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 2.7, 0)
		elseif State.FlingActive then
			for i = 1, #CachedParts do
				if CachedParts[i] then CachedParts[i].CanCollide = false end
			end
			CachedRoot.CFrame = targetRoot.CFrame
			CachedRoot.AssemblyAngularVelocity = Vector3.new(0, 9500, 0)
		end
	end

	-- Spinbot (Self Rotation)
	if State.Spinbot and not State.FlingActive then
		CachedRoot.CFrame = CachedRoot.CFrame * CFrame.Angles(0, math.rad(State.SpinSpeed), 0)
	end

	-- Swim in Air
	if State.SwimInAir then
		CachedHum:ChangeState(Enum.HumanoidStateType.Swimming)
	end

	-- Movement-Macro Aufzeichnung
	if State.MacroRecording then
		table.insert(macroFrames, CachedRoot.CFrame)
		macroStatLbl.Text = "Macro Frames: " .. #macroFrames
	end

	-- Air-Walk Plattform
	if State.AirWalk and airWalkPart then
		airWalkPart.CFrame = CFrame.new(CachedRoot.Position.X, State.AirWalkY, CachedRoot.Position.Z)
	end

	CachedHum.WalkSpeed = State.WalkSpeed
	CachedHum.UseJumpPower = true
	CachedHum.JumpPower = State.JumpPower

	-- Auto-Bhop
	if State.AutoBhop and UserInputService:IsKeyDown(Enum.KeyCode.Space) and CachedHum.FloorMaterial ~= Enum.Material.Air then
		CachedHum.Jump = true
	end

	-- Spider-Climb
	if State.SpiderClimb and UserInputService:IsKeyDown(Enum.KeyCode.W) then
		local params = RaycastParams.new()
		params.FilterDescendantsInstances = {CachedChar}
		local hit = workspace:Raycast(CachedRoot.Position, CachedRoot.CFrame.LookVector * 3, params)
		if hit then
			local v = CachedRoot.AssemblyLinearVelocity
			CachedRoot.AssemblyLinearVelocity = Vector3.new(v.X, State.WalkSpeed * 1.1, v.Z)
		end
	end

	-- Vehicle Nitro
	if State.VehicleNitro and UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) and CachedHum.SeatPart and CachedHum.SeatPart:IsA("VehicleSeat") then
		CachedHum.SeatPart.AssemblyLinearVelocity = camera.CFrame.LookVector * State.VehNitroPower
	end

	-- Dynamic Speed-FOV
	if State.DynamicFOV then
		local spd = CachedRoot.AssemblyLinearVelocity.Magnitude
		camera.FieldOfView = math.clamp(State.BaseFOV + (spd - 16) * 0.35, State.BaseFOV, 120)
	end

	-- Noclip
	if State.Noclip then
		for i = 1, #CachedParts do
			local p = CachedParts[i]
			if p and p.CanCollide then p.CanCollide = false end
		end
	end

	-- Moderner 3D Fly Modus
	if State.Fly then
		CachedHum.PlatformStand = true
		if not flyAtt or flyAtt.Parent ~= CachedRoot then
			cleanupFlyConstraints()
			flyAtt = Instance.new("Attachment", CachedRoot)
			flyAtt.Name = "TestProFlyAtt"

			flyLv = Instance.new("LinearVelocity", CachedRoot)
			flyLv.Name = "TestProFlyLV"
			flyLv.Attachment0 = flyAtt
			flyLv.MaxForce = math.huge
			flyLv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
			flyLv.RelativeTo = Enum.ActuatorRelativeTo.World

			flyAo = Instance.new("AlignOrientation", CachedRoot)
			flyAo.Name = "TestProFlyAO"
			flyAo.Mode = Enum.OrientationAlignmentMode.OneAttachment
			flyAo.Attachment0 = flyAtt
			flyAo.MaxTorque = math.huge
			flyAo.Responsiveness = 50
		end

		local md = Vector3.zero
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then md += camera.CFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then md -= camera.CFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then md -= camera.CFrame.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then md += camera.CFrame.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then md += Vector3.new(0, 1, 0) end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then md -= Vector3.new(0, 1, 0) end

		flyLv.VectorVelocity = md.Magnitude > 0 and (md.Unit * State.FlySpeed) or Vector3.zero
		flyAo.CFrame = camera.CFrame
	else
		if flyLv or flyAo or flyAtt then cleanupFlyConstraints() end
	end
end))

-- Gedrosselter 0.5s Telemetry & Kompass Loop
task.spawn(function()
	local fCount, lTick = 0, os.clock()
	TrackConn(RunService.RenderStepped:Connect(function() fCount += 1 end))
	local dirs = {"N", "NO", "O", "SO", "S", "SW", "W", "NW"}

	while State.Running and gui and gui.Parent do
		task.wait(0.5)
		local dt = os.clock() - lTick
		local fps = math.floor(fCount / math.max(dt, 0.001))
		local ping = 0
		pcall(function() ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue()) end)
		wmDate.Text = os.date("%b %d %Y %H:%M")
		wmStats.Text = string.format("%d FPS • %dms", fps, ping)
		fCount = 0 lTick = os.clock()

		if State.ShowCompass and CachedRoot then
			local look = camera.CFrame.LookVector
			local deg = math.deg(math.atan2(-look.X, -look.Z)) % 360
			local dir = dirs[math.floor((deg + 22.5) / 45) % 8 + 1]
			compassLbl.Text = string.format("%s (%.0f°) • %.0f, %.0f, %.0f", dir, deg, CachedRoot.Position.X, CachedRoot.Position.Y, CachedRoot.Position.Z)
		end
	end
end)

