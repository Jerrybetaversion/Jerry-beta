local function cleanupFlyConstraints()
	if flyLv then flyLv:Destroy() flyLv = nil end
	if flyAo then flyAo:Destroy() flyAo = nil end
	if flyAtt then flyAtt:Destroy() flyAtt = nil end
	if CachedHum and CachedHum.PlatformStand then
		CachedHum.PlatformStand = false
	end
end

local function updateZeroG()
	if not CachedRoot then return end
	local existing = CachedRoot:FindFirstChild("TestProZeroG")
	local existingAtt = CachedRoot:FindFirstChild("TestProZeroGAtt")
	if State.ZeroG and not existing then
		local att = Instance.new("Attachment", CachedRoot)
		att.Name = "TestProZeroGAtt"
		local vf = Instance.new("VectorForce", CachedRoot)
		vf.Name = "TestProZeroG"
		vf.Attachment0 = att
		vf.RelativeTo = Enum.ActuatorRelativeTo.World
		vf.Force = Vector3.new(0, CachedRoot.AssemblyMass * workspace.Gravity, 0)
	elseif not State.ZeroG then
		if existing then existing:Destroy() end
		if existingAtt then existingAtt:Destroy() end
	end
end

local function applyBodyMaterial(enable)
	if not CachedChar then return end
	if enable then
		for _, p in ipairs(CachedChar:GetDescendants()) do
			if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
				if not OrigPartMaterials[p] then
					OrigPartMaterials[p] = {Mat = p.Material, Col = p.Color}
				end
				p.Material = Enum.Material.ForceField
				p.Color = Colors.Accent
			end
		end
	else
		for p, data in pairs(OrigPartMaterials) do
			if p and p.Parent then
				p.Material = data.Mat
				p.Color = data.Col
			end
		end
		table.clear(OrigPartMaterials)
	end
end

local function refreshCharCache(char)
	cleanupFlyConstraints()
	CachedChar = char
	CachedParts = {}
	table.clear(OrigPartMaterials)
	if not char then CachedHum, CachedRoot = nil, nil return end
	CachedHum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 5)
	CachedRoot = char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart", 5)
	for _, p in ipairs(char:GetDescendants()) do
		if p:IsA("BasePart") then table.insert(CachedParts, p) end
	end

	if CachedHum then
		TrackConn(CachedHum.Died:Connect(function()
			if CachedRoot then State.LastDeathCFrame = CachedRoot.CFrame end
		end))
	end
	if State.AutoRespawnPos and State.LastDeathCFrame and CachedRoot then
		task.wait(0.15)
		CachedRoot.CFrame = State.LastDeathCFrame + Vector3.new(0, 3, 0)
	end
	if State.ZeroG then updateZeroG() end
	if State.ForcefieldBody then applyBodyMaterial(true) end
end

