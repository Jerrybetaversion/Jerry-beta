	Env.rebuildOnlinePlayers = function()
		playerRowsHolder:ClearAllChildren()
		local l = Instance.new("UIListLayout", playerRowsHolder) l.Padding = UDim.new(0, 4)
		local q = string.lower(searchBox.Text)

		local targets = GetCombatTargets()
		if #targets == 0 then
			table.insert(targets, {Name = player.DisplayName, ServerIndex = 1, Char = Env.CachedChar})
		end

		for i, t in ipairs(targets) do
			local labelStr = string.format("%s ID: %d", t.Name, t.ServerIndex or i)
			if q == "" or string.find(string.lower(labelStr), q, 1, true) then
				local isSel = (State.SelectedTarget and State.SelectedTarget.Name == t.Name) or (not State.SelectedTarget and i == 1)
				if isSel and not State.SelectedTarget then State.SelectedTarget = t end

				local pBtn = Instance.new("TextButton", playerRowsHolder)
				pBtn.Size = UDim2.new(1, 0, 0, 32)
				pBtn.BackgroundColor3 = isSel and Colors.ActiveTabBg or Colors.ElementBg
				pBtn.BackgroundTransparency = isSel and 0 or 0.5
				pBtn.Text = ""
				corner(pBtn, 5)

				local check = Instance.new("TextLabel", pBtn)
				check.Size = UDim2.new(0, 20, 1, 0) check.Position = UDim2.new(0, 8, 0, 0)
				check.BackgroundTransparency = 1 check.Text = isSel and "✓" or ""
				check.Font = Enum.Font.GothamBold check.TextSize = 11 check.TextColor3 = Colors.Accent

