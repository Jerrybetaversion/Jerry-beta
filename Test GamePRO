		UI.thBarFill.Size = UDim2.new(math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1), 0, 1, 0)
	else
		UI.targetHud.Visible = false
	end

	-- Aim-Assist & Silent Aim Logik
	if closestTarget then
		if State.SilentAim then
			-- Silent Aim: Lenkt Kamera oder Blickwinkel direkt auf das vorhergesagte Ziel
			camera.CFrame = CFrame.lookAt(camera.CFrame.Position, closestTarget.Position)
		elseif State.AimAssist and Svc.UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
			local goalCFrame = CFrame.lookAt(camera.CFrame.Position, closestTarget.Position)
			local alpha = math.clamp(State.AimSmoothness / 100, 0.05, 1)
			camera.CFrame = camera.CFrame:Lerp(goalCFrame, alpha)
		end
	end

	if State.Triggerbot and mouse.Target and (os.clock() - lastTriggerShot > 0.12) then
		for _, t in ipairs(GetCombatTargets()) do
			if mouse.Target:IsDescendantOf(t.Char) then
				lastTriggerShot = os.clock()
				pcall(function()
					Svc.VUser:Button1Down(Vector2.zero, camera.CFrame)
					task.delay(0.02, function() Svc.VUser:Button1Up(Vector2.zero, camera.CFrame) end)
				end)
				break
			end
		end
	end

	UI.tracerContainer:ClearAllChildren()
	UI.radarDotsFolder:ClearAllChildren()
	if (State.ESPTracers or State.ShowRadar) and not State.Streamproof then
		local vp = camera.ViewportSize
		local start2D = Vector2.new(vp.X / 2, vp.Y - 10)

		for _, t in ipairs(GetCombatTargets()) do
			local hrp = t.Char:FindFirstChild("HumanoidRootPart")
			local hum = t.Char:FindFirstChildOfClass("Humanoid")
			if hrp and hum and hum.Health > 0 then
				if State.ESPTracers then
					local screenPos, onScreen = camera:WorldToViewportPoint(hrp.Position)
					if onScreen then
						local end2D = Vector2.new(screenPos.X, screenPos.Y)
						local diff = end2D - start2D
						local line = Instance.new("Frame", UI.tracerContainer)
						line.AnchorPoint = Vector2.new(0.5, 0.5)
						line.Position = UDim2.new(0, (start2D.X + end2D.X) / 2, 0, (start2D.Y + end2D.Y) / 2)
						line.Size = UDim2.new(0, diff.Magnitude, 0, 1.5)
						line.Rotation = math.deg(math.atan2(diff.Y, diff.X))
						line.BackgroundColor3 = t.Color line.BorderSizePixel = 0
					end
				end
				if State.ShowRadar and Env.CachedRoot then
					local rel = camera.CFrame:PointToObjectSpace(hrp.Position)
					local rx = math.clamp(rel.X / 120, -0.46, 0.46)
					local rz = math.clamp(rel.Z / 120, -0.46, 0.46)
					local dot = Instance.new("Frame", UI.radarDotsFolder)
					dot.Size = UDim2.new(0, 6, 0, 6) dot.AnchorPoint = Vector2.new(0.5, 0.5)
					dot.Position = UDim2.new(0.5 + rx, 0, 0.5 + rz, 0) dot.BackgroundColor3 = t.Color
					corner(dot, 3)
				end
			end
		end
	end

	if State.PartInspector and Svc.UIS:IsKeyDown(Enum.KeyCode.LeftAlt) and Svc.UIS:IsKeyDown(Enum.KeyCode.LeftControl) and mouse.Target then
		local t = mouse.Target local mPos = Svc.UIS:GetMouseLocation()
		UI.inspectorCard.Visible = true UI.inspectorCard.Position = UDim2.new(0, mPos.X + 16, 0, mPos.Y + 16)
		UI.inspectorLbl.Text = string.format("Name: %s\nClass: %s | Mat: %s\nCollide: %s", t.Name, t.ClassName, t.Material.Name, tostring(t.CanCollide))
	else
		UI.inspectorCard.Visible = false
	end

	if State.Freecam then
		local moveVec = Vector3.zero
		if Svc.UIS:IsKeyDown(Enum.KeyCode.W) then moveVec += camera.CFrame.LookVector end
		if Svc.UIS:IsKeyDown(Enum.KeyCode.S) then moveVec -= camera.CFrame.LookVector end
		if Svc.UIS:IsKeyDown(Enum.KeyCode.A) then moveVec -= camera.CFrame.RightVector end
		if Svc.UIS:IsKeyDown(Enum.KeyCode.D) then moveVec += camera.CFrame.RightVector end
		if Svc.UIS:IsKeyDown(Enum.KeyCode.Space) then moveVec += Vector3.new(0, 1, 0) end
		if Svc.UIS:IsKeyDown(Enum.KeyCode.LeftShift) then moveVec -= Vector3.new(0, 1, 0) end
		local basePos = (Env.freecamCF or camera.CFrame).Position + (moveVec * State.FreecamSpeed * dt)
		Env.freecamCF = CFrame.lookAt(basePos, basePos + camera.CFrame.LookVector)
		camera.CFrame = Env.freecamCF
		return
	end

	if not (Env.CachedHum and Env.CachedRoot) then return end

	if Env.CachedHum.FloorMaterial ~= Enum.Material.Air then
		State.SafeGroundPos = Env.CachedRoot.CFrame
	elseif State.AntiVoid and Env.CachedRoot.Position.Y < -55 and State.SafeGroundPos then
		Env.CachedRoot.AssemblyLinearVelocity = Vector3.zero
		Env.CachedRoot.CFrame = State.SafeGroundPos + Vector3.new(0, 4, 0)
	end

	local targetRoot = getTargetRoot()
	if targetRoot then
		if State.OrbitTarget then
			orbitAngle += dt * State.OrbitSpeed
			local offset = Vector3.new(math.cos(orbitAngle) * State.OrbitRadius, 1, math.sin(orbitAngle) * State.OrbitRadius)
			Env.CachedRoot.CFrame = CFrame.lookAt(targetRoot.Position + offset, targetRoot.Position)
		elseif State.BackpackAttach then
			Env.CachedRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 1.65)
		elseif State.HeadSit then
			Env.CachedHum.Sit = true
			Env.CachedRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 2.7, 0)
		elseif State.FlingActive then
			for i = 1, #Env.CachedParts do if Env.CachedParts[i] then Env.CachedParts[i].CanCollide = false end end
			Env.CachedRoot.CFrame = targetRoot.CFrame
			Env.CachedRoot.AssemblyAngularVelocity = Vector3.new(0, 9500, 0)
		end
	end

	if State.Spinbot and not State.FlingActive then
		Env.CachedRoot.CFrame = Env.CachedRoot.CFrame * CFrame.Angles(0, math.rad(State.SpinSpeed), 0)
	end

	if State.SwimInAir then Env.CachedHum:ChangeState(Enum.HumanoidStateType.Swimming) end

	if State.MacroRecording then
		table.insert(Env.macroFrames, Env.CachedRoot.CFrame)
		if Env.macroStatLbl then Env.macroStatLbl.Text = "Macro Frames: " .. #Env.macroFrames end
	end

	if State.AirWalk and Env.airWalkPart then
		Env.airWalkPart.CFrame = CFrame.new(Env.CachedRoot.Position.X, State.AirWalkY, Env.CachedRoot.Position.Z)
	end

	Env.CachedHum.WalkSpeed = State.WalkSpeed
	Env.CachedHum.UseJumpPower = true
	Env.CachedHum.JumpPower = State.JumpPower

	if State.AutoBhop and Svc.UIS:IsKeyDown(Enum.KeyCode.Space) and Env.CachedHum.FloorMaterial ~= Enum.Material.Air then
		Env.CachedHum.Jump = true
	end

	if State.SpiderClimb and Svc.UIS:IsKeyDown(Enum.KeyCode.W) then
		local params = RaycastParams.new() params.FilterDescendantsInstances = {Env.CachedChar}
		local hit = workspace:Raycast(Env.CachedRoot.Position, Env.CachedRoot.CFrame.LookVector * 3, params)
		if hit then
			local v = Env.CachedRoot.AssemblyLinearVelocity
			Env.CachedRoot.AssemblyLinearVelocity = Vector3.new(v.X, State.WalkSpeed * 1.1, v.Z)
		end
	end

	if State.VehicleNitro and Svc.UIS:IsKeyDown(Enum.KeyCode.LeftShift) and Env.CachedHum.SeatPart and Env.CachedHum.SeatPart:IsA("VehicleSeat") then
		Env.CachedHum.SeatPart.AssemblyLinearVelocity = camera.CFrame.LookVector * State.VehNitroPower
	end

	if State.DynamicFOV then
		local spd = Env.CachedRoot.AssemblyLinearVelocity.Magnitude
		camera.FieldOfView = math.clamp(State.BaseFOV + (spd - 16) * 0.35, State.BaseFOV, 120)
	end

	if State.Noclip then
		for i = 1, #Env.CachedParts do
			local p = Env.CachedParts[i]
			if p and p.CanCollide then p.CanCollide = false end
		end
	end

	if State.Fly then
		Env.CachedHum.PlatformStand = true
		if not Env.flyAtt or Env.flyAtt.Parent ~= Env.CachedRoot then
			cleanupFlyConstraints()
			Env.flyAtt = Instance.new("Attachment", Env.CachedRoot) Env.flyAtt.Name = "TestProFlyAtt"
			Env.flyLv = Instance.new("LinearVelocity", Env.CachedRoot) Env.flyLv.Name = "TestProFlyLV"
			Env.flyLv.Attachment0 = Env.flyAtt Env.flyLv.MaxForce = math.huge
			Env.flyLv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector Env.flyLv.RelativeTo = Enum.ActuatorRelativeTo.World
			Env.flyAo = Instance.new("AlignOrientation", Env.CachedRoot) Env.flyAo.Name = "TestProFlyAO"
			Env.flyAo.Mode = Enum.OrientationAlignmentMode.OneAttachment Env.flyAo.Attachment0 = Env.flyAtt
			Env.flyAo.MaxTorque = math.huge Env.flyAo.Responsiveness = 50
		end

		local md = Vector3.zero
		if Svc.UIS:IsKeyDown(Enum.KeyCode.W) then md += camera.CFrame.LookVector end
		if Svc.UIS:IsKeyDown(Enum.KeyCode.S) then md -= camera.CFrame.LookVector end
		if Svc.UIS:IsKeyDown(Enum.KeyCode.A) then md -= camera.CFrame.RightVector end
		if Svc.UIS:IsKeyDown(Enum.KeyCode.D) then md += camera.CFrame.RightVector end
		if Svc.UIS:IsKeyDown(Enum.KeyCode.Space) then md += Vector3.new(0, 1, 0) end
		if Svc.UIS:IsKeyDown(Enum.KeyCode.LeftShift) then md -= Vector3.new(0, 1, 0) end

		Env.flyLv.VectorVelocity = md.Magnitude > 0 and (md.Unit * State.FlySpeed) or Vector3.zero
		Env.flyAo.CFrame = camera.CFrame
	else
		if Env.flyLv or Env.flyAo or Env.flyAtt then cleanupFlyConstraints() end
	end
end))

