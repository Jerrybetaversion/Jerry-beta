		card.Size = UDim2.new(0, 215, 0, 44)
		card.Position = UDim2.new(1, -227, 0.5, -22)
		card.BackgroundColor3 = Colors.GroupBg
		corner(card, 6)
		stroke(card, Colors.Stroke, 1)

		local pLbl = Instance.new("TextLabel", card)
		pLbl.Size = UDim2.new(0.6, 0, 0, 16) pLbl.Position = UDim2.new(0, 10, 0, 5)
		pLbl.BackgroundTransparency = 1 pLbl.Text = ps.Label or "Speed"
		pLbl.Font = Enum.Font.GothamMedium pLbl.TextSize = 10 pLbl.TextColor3 = Colors.TextMain
		pLbl.TextXAlignment = Enum.TextXAlignment.Left

		local pVal = Instance.new("TextLabel", card)
		pVal.Size = UDim2.new(0.4, -10, 0, 16) pVal.Position = UDim2.new(0.6, 0, 0, 5)
		pVal.BackgroundTransparency = 1
		pVal.Text = string.format("%.2f", ps.Default or 1.0)
		pVal.Font = Enum.Font.GothamBold pVal.TextSize = 10 pVal.TextColor3 = Colors.TextMain
		pVal.TextXAlignment = Enum.TextXAlignment.Right

		local pTrack = Instance.new("TextButton", card)
		pTrack.Size = UDim2.new(1, -20, 0, 4) pTrack.Position = UDim2.new(0, 10, 0, 30)
		pTrack.BackgroundColor3 = Colors.TrackBg pTrack.Text = "" pTrack.AutoButtonColor = false
		corner(pTrack, 2)

		local pFill = Instance.new("Frame", pTrack)
		pFill.Size = UDim2.new(((ps.Default or 1) - ps.Min) / (ps.Max - ps.Min), 0, 1, 0)
		pFill.BackgroundColor3 = Colors.Accent corner(pFill, 2)
		table.insert(Env.AccentFills, pFill)

		local pKnob = Instance.new("Frame", pFill)
		pKnob.Size = UDim2.new(0, 10, 0, 10) pKnob.Position = UDim2.new(1, -5, 0.5, -5)
		pKnob.BackgroundColor3 = Colors.Accent corner(pKnob, 5)
		table.insert(Env.AccentFills, pKnob)

		local dragP = false
		local function updP(inp)
			local r = math.clamp((inp.Position.X - pTrack.AbsolutePosition.X) / math.max(pTrack.AbsoluteSize.X, 1), 0, 1)
			local v = ps.Min + (ps.Max - ps.Min) * r
			pVal.Text = string.format("%.2f", v)
			pFill.Size = UDim2.new(r, 0, 1, 0)
			if ps.Callback then ps.Callback(v) end
		end
		pTrack.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 then dragP = true updP(i) end
		end)
		TrackConn(Svc.UIS.InputEnded:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 then dragP = false end
		end))
		TrackConn(Svc.UIS.InputChanged:Connect(function(i)
			if dragP and i.UserInputType == Enum.UserInputType.MouseMovement then updP(i) end
		end))
	end

	local obj = {Get = function() return state end, Pill = pill, Dot = dot, Key = nil, BindBtn = bindBtn, Label = labelText}
	table.insert(Env.AccentPills, obj)
	table.insert(Env.CustomKeybinds, obj)
	Env.AllTogglesMap[labelText] = obj

	function obj.Set(v)
		state = v
		pill.BackgroundColor3 = state and Colors.AccentDim or Colors.TrackBg
		dot.BackgroundColor3 = state and Colors.Accent or Color3.fromRGB(70, 70, 78)
		tween(dot, 0.15, {Position = state and UDim2.new(1, -14, 0.5, -6) or UDim2.new(0, 2, 0.5, -6)})
		callback(state)
	end

	bindBtn.MouseButton1Click:Connect(function()
		playUISound()
		if popupHolder then
			popupHolder.Visible = not popupHolder.Visible
			bindBtn.TextColor3 = popupHolder.Visible and Colors.Accent or Colors.TextMuted
			return
		end
		if Env.BindingToggleObj == obj then
			obj.Key = nil
			bindBtn.Text = "⚙"
			bindBtn.TextColor3 = Colors.TextMuted
			Env.BindingToggleObj = nil
		else
			Env.BindingToggleObj = obj
			bindBtn.Text = ".."
			bindBtn.TextColor3 = Colors.Accent
		end
	end)

	row.MouseButton1Click:Connect(function() playUISound() obj.Set(not state) end)
	return obj
end

