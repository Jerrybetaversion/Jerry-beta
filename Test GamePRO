		target.Parent = nil
	end
end))

local lastTriggerShot = 0
local orbitAngle = 0
local fpsCount, lastFpsTick = 0, os.clock()

TrackConn(Svc.Run.RenderStepped:Connect(function(dt)
	fpsCount += 1
	if os.clock() - lastFpsTick >= 0.5 then
		local fps = math.floor(fpsCount / (os.clock() - lastFpsTick))
		UI.wmLabel.Text = string.format("GamePro • Lifetime • %d FPS", fps)
		fpsCount = 0
		lastFpsTick = os.clock()
	end

	RenderSmoothESP()

	if State.Fullbright then
		Svc.Lighting.Brightness = 2.5
		Svc.Lighting.GlobalShadows = false
		Svc.Lighting.Ambient = Color3.fromRGB(175, 175, 175)
	end

	local closestTarget = getClosestTargetInFOV()

	if State.TargetHUD and closestTarget and not State.Streamproof then
		UI.targetHud.Visible = true
		local hum = closestTarget.Hum
		local dist = Env.CachedRoot and math.floor((closestTarget.Part.Position - Env.CachedRoot.Position).Magnitude / 3.2) or 0
		UI.thName.Text = "⌖ " .. closestTarget.Data.Name
		UI.thSub.Text = string.format("%d / %d HP • %dm", math.floor(hum.Health), math.floor(hum.MaxHealth), dist)
		UI.thBarFill.Size = UDim2.new(math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1), 0, 1, 0)
	else
		UI.targetHud.Visible = false
	end

	if closestTarget then
		local aimPos = closestTarget.Position
		if State.SilentAim then
			camera.CFrame = CFrame.lookAt(camera.CFrame.Position, aimPos)
		elseif State.AimAssist and (Svc.UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) or State.TargetLock) then
			local goalCFrame = CFrame.lookAt(camera.CFrame.Position, aimPos)
			local baseAlpha = math.clamp((105 - State.AimSmoothness) / 100, 0.04, 1)
			camera.CFrame = camera.CFrame:Lerp(goalCFrame, baseAlpha)
		end
	end

	if State.Triggerbot and mouse.Target and (os.clock() - lastTriggerShot > (State.TriggerDelay / 1000)) then
		for _, t in ipairs(GetCombatTargets()) do
			if mouse.Target:IsDescendantOf(t.Char) then
				lastTriggerShot = os.clock()
				pcall(function()
					Svc.VUser:Button1Down(Vector2.zero, camera.CFrame)
					task.delay(0.02, function() Svc.VUser:Button1Up(Vector2.zero, camera.CFrame) end)
				end)
				break
			end
		end
	end

	if State.Freecam then
		local moveVec = Vector3.zero
		if Svc.UIS:IsKeyDown(Enum.KeyCode.W) then moveVec += camera.CFrame.LookVector end
		if Svc.UIS:IsKeyDown(Enum.KeyCode.S) then moveVec -= camera.CFrame.LookVector end
		if Svc.UIS:IsKeyDown(Enum.KeyCode.A) then moveVec -= camera.CFrame.RightVector end
		if Svc.UIS:IsKeyDown(Enum.KeyCode.D) then moveVec += camera.CFrame.RightVector end
		if Svc.UIS:IsKeyDown(Enum.KeyCode.Space) then moveVec += Vector3.new(0, 1, 0) end
		if Svc.UIS:IsKeyDown(Enum.KeyCode.LeftShift) then moveVec -= Vector3.new(0, 1, 0) end
		local basePos = (Env.freecamCF or camera.CFrame).Position + (moveVec * State.FreecamSpeed * dt)
		Env.freecamCF = CFrame.lookAt(basePos, basePos + camera.CFrame.LookVector)
		camera.CFrame = Env.freecamCF
		return
	end

	if not (Env.CachedHum and Env.CachedRoot) then return end

	if State.GodMode and Env.CachedHum.Health < Env.CachedHum.MaxHealth then
		Env.CachedHum.Health = Env.CachedHum.MaxHealth
	end

	local targetRoot = getTargetRoot()
	if targetRoot then
		if State.OrbitTarget then
			orbitAngle += dt * State.OrbitSpeed
			local offset = Vector3.new(math.cos(orbitAngle) * State.OrbitRadius, 1, math.sin(orbitAngle) * State.OrbitRadius)
			Env.CachedRoot.CFrame = CFrame.lookAt(targetRoot.Position + offset, targetRoot.Position)
		elseif State.HeadSit then
			Env.CachedHum.Sit = true
			Env.CachedRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 2.7, 0)
		elseif State.FlingActive then
			for i = 1, #Env.CachedParts do if Env.CachedParts[i] then Env.CachedParts[i].CanCollide = false end end
			Env.CachedRoot.CFrame = targetRoot.CFrame
			Env.CachedRoot.AssemblyAngularVelocity = Vector3.new(0, 9500, 0)
		elseif State.BlackholeActive then
			targetRoot.CFrame = Env.CachedRoot.CFrame * CFrame.new(0, 0, -5)
		end
	end

	if State.Spinbot and not State.FlingActive then
		Env.CachedRoot.CFrame = Env.CachedRoot.CFrame * CFrame.Angles(0, math.rad(State.SpinSpeed), 0)
	end

	Env.CachedHum.WalkSpeed = State.WalkSpeed
	Env.CachedHum.UseJumpPower = true
	if not State.VehLockInside then Env.CachedHum.JumpPower = State.JumpPower end

	if State.AutoBhop and Svc.UIS:IsKeyDown(Enum.KeyCode.Space) and Env.CachedHum.FloorMaterial ~= Enum.Material.Air then
		Env.CachedHum.Jump = true
	end

	if (State.VehAccelMod or State.VehHornBoost) and Env.CachedHum.SeatPart and Env.CachedHum.SeatPart:IsA("VehicleSeat") then
		if (State.VehAccelMod and Svc.UIS:IsKeyDown(Enum.KeyCode.W)) or (State.VehHornBoost and Svc.UIS:IsKeyDown(Enum.KeyCode.E)) then
			Env.CachedHum.SeatPart.AssemblyLinearVelocity = camera.CFrame.LookVector * State.VehAccelVal
		end
	end

	if State.Noclip then
		for i = 1, #Env.CachedParts do
			local p = Env.CachedParts[i]
			if p and p.CanCollide then p.CanCollide = false end
		end
	end

	if State.Fly then
		Env.CachedHum.PlatformStand = true
		if not Env.flyAtt or Env.flyAtt.Parent ~= Env.CachedRoot then
			cleanupFlyConstraints()
			Env.flyAtt = Instance.new("Attachment", Env.CachedRoot) Env.flyAtt.Name = "GameProFlyAtt"
			Env.flyLv = Instance.new("LinearVelocity", Env.CachedRoot) Env.flyLv.Name = "GameProFlyLV"
			Env.flyLv.Attachment0 = Env.flyAtt Env.flyLv.MaxForce = math.huge
			Env.flyLv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector Env.flyLv.RelativeTo = Enum.ActuatorRelativeTo.World
			Env.flyAo = Instance.new("AlignOrientation", Env.CachedRoot) Env.flyAo.Name = "GameProFlyAO"
			Env.flyAo.Mode = Enum.OrientationAlignmentMode.OneAttachment Env.flyAo.Attachment0 = Env.flyAtt
			Env.flyAo.MaxTorque = math.huge Env.flyAo.Responsiveness = 50
		end

		local md = Vector3.zero
		if Svc.UIS:IsKeyDown(Enum.KeyCode.W) then md += camera.CFrame.LookVector end
		if Svc.UIS:IsKeyDown(Enum.KeyCode.S) then md -= camera.CFrame.LookVector end
		if Svc.UIS:IsKeyDown(Enum.KeyCode.A) then md -= camera.CFrame.RightVector end
		if Svc.UIS:IsKeyDown(Enum.KeyCode.D) then md += camera.CFrame.RightVector end
		if Svc.UIS:IsKeyDown(Enum.KeyCode.Space) then md += Vector3.new(0, 1, 0) end
		if Svc.UIS:IsKeyDown(Enum.KeyCode.LeftShift) then md -= Vector3.new(0, 1, 0) end

		Env.flyLv.VectorVelocity = md.Magnitude > 0 and (md.Unit * State.FlySpeed) or Vector3.zero
		Env.flyAo.CFrame = camera.CFrame
	else
		if Env.flyLv or Env.flyAo or Env.flyAtt then cleanupFlyConstraints() end
	end
end))

