local function GetEnabledAimbotBones()
	local list = {}
	if State.AimHitHead then table.insert(list, "Head") end
	if State.AimHitNeck then table.insert(list, "UpperTorso") end
	if State.AimHitUpperBody then table.insert(list, "HumanoidRootPart") table.insert(list, "UpperTorso") end
	if State.AimHitPelvis then table.insert(list, "LowerTorso") table.insert(list, "Torso") end
	if State.AimHitRightCalf then table.insert(list, "RightLowerLeg") table.insert(list, "Right Leg") end
	if State.AimHitLeftCalf then table.insert(list, "LeftLowerLeg") table.insert(list, "Left Leg") end
	if #list == 0 then table.insert(list, "Head") table.insert(list, "HumanoidRootPart") end
	return list
end

local function GetEnabledSilentBones()
	local list = {}
	if State.SilentHitHead then table.insert(list, "Head") end
	if State.SilentHitNeck then table.insert(list, "UpperTorso") end
	if State.SilentHitPelvis then table.insert(list, "LowerTorso") table.insert(list, "HumanoidRootPart") end
	if State.SilentHitLeftHand then table.insert(list, "LeftHand") table.insert(list, "Left Arm") end
	if State.SilentHitRightHand then table.insert(list, "RightHand") table.insert(list, "Right Arm") end
	if State.SilentHitLeftFoot then table.insert(list, "LeftFoot") table.insert(list, "Left Leg") end
	if State.SilentHitRightFoot then table.insert(list, "RightFoot") table.insert(list, "Right Leg") end
	if #list == 0 then table.insert(list, "Head") table.insert(list, "HumanoidRootPart") end
	return list
end

local function PassesCombatFilters(t, hum, hrp, head, isSilent)
	local fPlayers = isSilent and State.SilentFilterPlayers or State.AimFilterPlayers
	local fNPC = isSilent and State.SilentFilterNPC or State.AimFilterNPC
	local fFriends = isSilent and State.SilentFilterFriends or State.AimFilterFriends
	local iDead = isSilent and State.SilentIgnoreDead or State.AimIgnoreDead
	local iRoll = isSilent and State.SilentIgnoreRolling or State.AimIgnoreRolling
	local iInvis = isSilent and State.SilentIgnoreInvisible or State.AimIgnoreInvisible
	local stopHp = isSilent and State.SilentStopAtHealthPct or State.AimStopAtHealthPct

	if t.IsNPC and not fNPC then return false end
	if not t.IsNPC and not fPlayers then return false end
	if t.IsFriend and not fFriends then return false end
	if iDead and hum.Health <= 0 then return false end
	if stopHp > 0 and (hum.Health / math.max(hum.MaxHealth, 1)) * 100 <= stopHp then return false end
	if iInvis and head and head.Transparency > 0.85 then return false end
	if iRoll and hum:GetState() == Enum.HumanoidStateType.FallingDown then return false end
	return true
end

local function FindBestCombatTarget(isSilent)
	local maxFOV = isSilent and State.SilentFOV or State.AimFOV
	local maxDist = isSilent and State.SilentMaxDistance or State.MaxAimDistance
	local prioMode = isSilent and State.SilentPriority or State.AimPriority
	local nearestBone = isSilent and State.SilentNearestBone or State.AimNearestBone
	local boneNames = isSilent and GetEnabledSilentBones() or GetEnabledAimbotBones()
	local wallCheck = isSilent and (not State.SilentMagicBullet) or true
	local viewportCenter = camera.ViewportSize * 0.5

	-- Target Lock Prüfung
	local locked = isSilent and Env.LockedSilentTarget or Env.LockedAimbotTarget
	if locked and locked.Char and locked.Char.Parent then
		local lHum = locked.Char:FindFirstChildOfClass("Humanoid")
		local lPart = locked.Part
		if lHum and lHum.Health > 0 and lPart and lPart.Parent then
			local sp, onScr = camera:WorldToViewportPoint(lPart.Position)
			if onScr then
				return {Part = lPart, Position = lPart.Position, ScreenPos = Vector2.new(sp.X, sp.Y), Hum = lHum, Data = locked.Data, Char = locked.Char}
			end
		end
	end

	local bestTarget = nil
	local bestScore = math.huge

	for _, t in ipairs(GetAllEntities()) do
		if t.Char == Env.CachedChar then continue end
		local hum = t.Char:FindFirstChildOfClass("Humanoid")
		local hrp = t.Char:FindFirstChild("HumanoidRootPart")
		local head = t.Char:FindFirstChild("Head")

		if hum and hrp and PassesCombatFilters(t, hum, hrp, head, isSilent) then
			local worldDist = (hrp.Position - camera.CFrame.Position).Magnitude / 3.2
			if worldDist > maxDist then continue end

			-- Besten Bone aus den aktivierten Hitbox-Toggles suchen
			local chosenPart = nil
			local bestBoneDist2D = math.huge

			-- Wheel Override System (falls aktiviert und Ziel im Fahrzeug sitzt)
			if not isSilent and State.AimWheelOverride and hum.SeatPart then
				local vehModel = hum.SeatPart:FindFirstAncestorOfClass("Model")
				if vehModel then
					for _, p in ipairs(vehModel:GetDescendants()) do
						if p:IsA("BasePart") and (string.find(string.lower(p.Name), "wheel") or string.find(string.lower(p.Name), "tire")) then
							if not (State.AimSkipPoppedTires and p.Transparency > 0.7) then
								chosenPart = p
								break
							end
						end
					end
				end
			end

			if not chosenPart then
				for _, bName in ipairs(boneNames) do
					local bp = t.Char:FindFirstChild(bName)
					if bp then
						local sp, vis = camera:WorldToViewportPoint(bp.Position)
						if vis then
							local d2 = (Vector2.new(sp.X, sp.Y) - viewportCenter).Magnitude
							if nearestBone then
								if d2 < bestBoneDist2D then
									bestBoneDist2D = d2
									chosenPart = bp
								end
							else
								chosenPart = bp
								bestBoneDist2D = d2
								break
							end
						end
					end
				end
			end

			if chosenPart then
				local finalPos = chosenPart.Position
				if not isSilent and State.AimPrediction and chosenPart.AssemblyLinearVelocity then
					finalPos += chosenPart.AssemblyLinearVelocity * State.PredictionFactor
				end

				local screenPos, onScreen = camera:WorldToViewportPoint(finalPos)
				if onScreen then
					local dist2D = (Vector2.new(screenPos.X, screenPos.Y) - viewportCenter).Magnitude
					if dist2D <= maxFOV then
						if wallCheck and not IsTargetVisible(t.Char, chosenPart) then
							continue
						end

						local score = dist2D
						if prioMode == "Nearest by Distance" then
							score = worldDist
						elseif prioMode == "Lowest Health" then
							score = hum.Health
						elseif prioMode == "Highest Threat" and Env.CachedRoot then
							local toMe = (Env.CachedRoot.Position - hrp.Position).Unit
							local aimThreat = hrp.CFrame.LookVector:Dot(toMe)
							score = (1 - aimThreat) * 500 + dist2D * 0.2
						end

						if not isSilent and State.AimPrioritiseDriver and hum.SeatPart and hum.SeatPart:IsA("VehicleSeat") then
							score = score * 0.35
						end

						if score < bestScore then
							bestScore = score
							bestTarget = {
								Part = chosenPart,
								Position = finalPos,
								ScreenPos = Vector2.new(screenPos.X, screenPos.Y),
								Hum = hum,
								Data = t,
								Char = t.Char,
								WorldDist = worldDist
							}
						end
					end
				end
			end
		end
	end

	if bestTarget then
		if isSilent and State.SilentTargetLock then
			Env.LockedSilentTarget = bestTarget
		elseif not isSilent and State.TargetLock then
			Env.LockedAimbotTarget = bestTarget
		end
	end

	return bestTarget
end

TrackConn(mouse.Button1Down:Connect(function()
