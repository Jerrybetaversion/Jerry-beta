local function CreateCategory(icon, name)
	local btn = Instance.new("TextButton", UI.navScroll)
	btn.Size = UDim2.new(1, 0, 0, 34) btn.BackgroundColor3 = Colors.ActiveTabBg
	btn.BackgroundTransparency = 1 btn.Text = "" btn.AutoButtonColor = false
	corner(btn, 6)

	local iconLbl = Instance.new("TextLabel", btn)
	iconLbl.Size = UDim2.new(0, 22, 1, 0) iconLbl.Position = UDim2.new(0, 10, 0, 0)
	iconLbl.BackgroundTransparency = 1 iconLbl.Text = icon
	iconLbl.Font = Enum.Font.GothamBold iconLbl.TextSize = 12 iconLbl.TextColor3 = Colors.TextMuted

	local txtLbl = Instance.new("TextLabel", btn)
	txtLbl.Size = UDim2.new(1, -38, 1, 0) txtLbl.Position = UDim2.new(0, 36, 0, 0)
	txtLbl.BackgroundTransparency = 1 txtLbl.Text = name
	txtLbl.Font = Enum.Font.GothamMedium txtLbl.TextSize = 12 txtLbl.TextColor3 = Colors.TextMuted
	txtLbl.TextXAlignment = Enum.TextXAlignment.Left

	local subTabs = {}
	local firstSub = true

	local function activateCategory()
		for _, c in ipairs(Env.Categories) do
			c.Btn.BackgroundTransparency = 1
			c.Icon.TextColor3 = Colors.TextMuted
			c.Txt.TextColor3 = Colors.TextMuted
			for _, st in ipairs(c.SubTabs) do st.Btn.Visible = false st.Page.Visible = false end
		end
		btn.BackgroundTransparency = 0
		btn.BackgroundColor3 = Colors.ActiveTabBg
		iconLbl.TextColor3 = Colors.Accent
		txtLbl.TextColor3 = Colors.TextMain

		local activeSub = subTabs[1]
		for _, st in ipairs(subTabs) do
			st.Btn.Visible = true
			if st.Active then activeSub = st end
		end
		if activeSub then activeSub.Select() end
	end

	btn.MouseButton1Click:Connect(function() playUISound() activateCategory() end)
	table.insert(Env.Categories, {Btn = btn, Icon = iconLbl, Txt = txtLbl, SubTabs = subTabs, Activate = activateCategory})

	local CatAPI = {}
	function CatAPI:AddSubTab(subIcon, subName)
		local sBtn = Instance.new("TextButton", UI.subTabHolder)
		sBtn.Size = UDim2.new(0, 0, 0, 32) sBtn.AutomaticSize = Enum.AutomaticSize.X
		sBtn.BackgroundColor3 = Colors.ActiveSubTabBg sBtn.BackgroundTransparency = 0
		sBtn.Text = "" sBtn.AutoButtonColor = false
		sBtn.Visible = false corner(sBtn, 6)
		local sStroke = stroke(sBtn, Colors.Stroke, 1)

		local sPad = Instance.new("UIPadding", sBtn)
		sPad.PaddingLeft = UDim.new(0, 12) sPad.PaddingRight = UDim.new(0, 12)

		local sLayout = Instance.new("UIListLayout", sBtn)
		sLayout.FillDirection = Enum.FillDirection.Horizontal
		sLayout.VerticalAlignment = Enum.VerticalAlignment.Center
		sLayout.Padding = UDim.new(0, 6)

		local sIcon = Instance.new("TextLabel", sBtn)
		sIcon.Size = UDim2.new(0, 14, 1, 0) sIcon.BackgroundTransparency = 1
		sIcon.Text = subIcon sIcon.Font = Enum.Font.GothamBold sIcon.TextSize = 11
		sIcon.TextColor3 = Colors.TextMuted

		local sTxt = Instance.new("TextLabel", sBtn)
		sTxt.Size = UDim2.new(0, 0, 1, 0) sTxt.AutomaticSize = Enum.AutomaticSize.X
		sTxt.BackgroundTransparency = 1 sTxt.Text = subName
		sTxt.Font = Enum.Font.GothamMedium sTxt.TextSize = 11 sTxt.TextColor3 = Colors.TextMuted

		local page = Instance.new("Frame", UI.pagesContainer)
		page.Size = UDim2.new(1, 0, 1, 0) page.BackgroundTransparency = 1 page.Visible = false

		local leftCol = Instance.new("ScrollingFrame", page)
		leftCol.Size = UDim2.new(0.488, 0, 1, 0) leftCol.BackgroundTransparency = 1
		leftCol.ScrollBarThickness = 2 leftCol.ScrollBarImageColor3 = Colors.Accent
		leftCol.AutomaticCanvasSize = Enum.AutomaticSize.Y leftCol.CanvasSize = UDim2.new(0, 0, 0, 0)
		local lList = Instance.new("UIListLayout", leftCol)
		lList.Padding = UDim.new(0, 14)

		local rightCol = Instance.new("ScrollingFrame", page)
		rightCol.Size = UDim2.new(0.488, 0, 1, 0) rightCol.Position = UDim2.new(0.512, 0, 0, 0)
		rightCol.BackgroundTransparency = 1 rightCol.ScrollBarThickness = 2 rightCol.ScrollBarImageColor3 = Colors.Accent
		rightCol.AutomaticCanvasSize = Enum.AutomaticSize.Y rightCol.CanvasSize = UDim2.new(0, 0, 0, 0)
		local rList = Instance.new("UIListLayout", rightCol)
		rList.Padding = UDim.new(0, 14)

		local subEntry = {Btn = sBtn, Icon = sIcon, Txt = sTxt, Page = page, Left = leftCol, Right = rightCol, Active = firstSub, Stroke = sStroke}
		function subEntry.Select()
			for _, st in ipairs(subTabs) do
				st.Active = false st.Page.Visible = false
				st.Btn.BackgroundColor3 = Colors.GroupBg
				st.Icon.TextColor3 = Colors.TextMuted
				st.Txt.TextColor3 = Colors.TextMuted
			end
			subEntry.Active = true page.Visible = true
			sBtn.BackgroundColor3 = Colors.ActiveSubTabBg
			sIcon.TextColor3 = Colors.Accent
			sTxt.TextColor3 = Colors.TextMain
		end

		sBtn.MouseButton1Click:Connect(function() playUISound() subEntry.Select() end)
		table.insert(subTabs, subEntry)
		if firstSub then firstSub = false end

		local SubAPI = {Page = page, Left = leftCol, Right = rightCol}
		function SubAPI:AddGroupbox(column, iconChar, title)
			local targetCol = (column == "Right") and rightCol or leftCol
			local box = Instance.new("Frame", targetCol)
			box.Size = UDim2.new(1, 0, 0, 0) box.AutomaticSize = Enum.AutomaticSize.Y
			box.BackgroundColor3 = Colors.GroupBg corner(box, 6) stroke(box, Colors.Stroke, 1)

			local boxLayout = Instance.new("UIListLayout", box)
			boxLayout.Padding = UDim.new(0, 0)

			local headerFrame = Instance.new("Frame", box)
			headerFrame.Size = UDim2.new(1, 0, 0, 38)
			headerFrame.BackgroundColor3 = Colors.GroupHeaderBg
			headerFrame.BackgroundTransparency = 0.4
			addBottomBorder(headerFrame)

			local hIcon = Instance.new("TextLabel", headerFrame)
			hIcon.Size = UDim2.new(0, 18, 1, 0) hIcon.Position = UDim2.new(0, 12, 0, 0)
			hIcon.BackgroundTransparency = 1 hIcon.Text = iconChar
			hIcon.Font = Enum.Font.GothamBold hIcon.TextSize = 12 hIcon.TextColor3 = Colors.Accent
			table.insert(Env.AccentTexts, hIcon)

			local header = Instance.new("TextLabel", headerFrame)
			header.Size = UDim2.new(1, -40, 1, 0) header.Position = UDim2.new(0, 32, 0, 0)
			header.BackgroundTransparency = 1
			header.Text = title header.Font = Enum.Font.GothamMedium header.TextSize = 12
			header.TextColor3 = Colors.TextMain header.TextXAlignment = Enum.TextXAlignment.Left

			local BoxAPI = {Frame = box, Header = headerFrame}
			function BoxAPI:Slider(lbl, min, max, def, suf, cb, dec) return CreateSlider(box, lbl, min, max, def, suf, cb, dec) end
			function BoxAPI:Toggle(lbl, def, cb, opts) return CreateToggle(box, lbl, def, cb, opts) end
			function BoxAPI:Dropdown(lbl, opts, defIdx, cb) return CreateDropdown(box, lbl, opts, defIdx, cb) end
			function BoxAPI:ColorRow(lbl, defCol, cb) return CreateColorRow(box, lbl, defCol, cb) end
			function BoxAPI:Segmented(lbl, a, b, cb) return CreateSegmented(box, lbl, a, b, cb) end
			function BoxAPI:FullButton(btnTxt, cb, bg) return CreateFullButton(box, btnTxt, cb, bg) end
			function BoxAPI:ButtonRow(list, h) return CreateButtonRow(box, list, h) end
			function BoxAPI:Section(txt) return CreateSectionHeader(box, txt) end
			function BoxAPI:KeybindRow(lbl, defTxt, defKey, cb) return CreateKeybindRow(box, lbl, defTxt, defKey, cb) end
			return BoxAPI
		end
		return SubAPI
	end

	return CatAPI
end

local function getTargetRoot()
	if not State.SelectedTarget or not State.SelectedTarget.Char then return nil end
	return State.SelectedTarget.Char:FindFirstChild("HumanoidRootPart")
end

local function resetHitboxes()
	for _, t in ipairs(GetAllEntities()) do
		local hrp = t.Char and t.Char:FindFirstChild("HumanoidRootPart")
		if hrp then
			hrp.Size = Vector3.new(2, 2, 1)
			hrp.Transparency = t.IsNPC and 0 or 1
		end
	end
end

