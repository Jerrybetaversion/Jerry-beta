local function Notify(title, msg, nType)
	if not State.Running then return end
	table.insert(NotifyHistory, 1, string.format("[%s] %s: %s", os.date("%H:%M:%S"), title, msg))
	if #NotifyHistory > 15 then table.remove(NotifyHistory) end
	if historyLabelRef then historyLabelRef.Text = table.concat(NotifyHistory, "\n") end

	if State.Streamproof then return end
	local col = (nType == "Success" and Colors.Success) or (nType == "Warn" and Colors.Warning) or (nType == "Alert" and Colors.Danger) or Colors.Accent

	local card = Instance.new("Frame", toastHolder)
	card.Size = UDim2.new(1, 0, 0, 44)
	card.BackgroundColor3 = Colors.GroupBg
	corner(card, 8)
	local st = stroke(card, col, 1.2)

	local bar = Instance.new("Frame", card)
	bar.Size = UDim2.new(0, 3, 1, -12) bar.Position = UDim2.new(0, 6, 0, 6)
	bar.BackgroundColor3 = col corner(bar, 2)

	local t1 = Instance.new("TextLabel", card)
	t1.Size = UDim2.new(1, -20, 0, 15) t1.Position = UDim2.new(0, 14, 0, 5)
	t1.BackgroundTransparency = 1 t1.Text = title t1.Font = Enum.Font.GothamBold t1.TextSize = 11
	t1.TextColor3 = col t1.TextXAlignment = Enum.TextXAlignment.Left

	local t2 = Instance.new("TextLabel", card)
	t2.Size = UDim2.new(1, -20, 0, 15) t2.Position = UDim2.new(0, 14, 0, 22)
	t2.BackgroundTransparency = 1 t2.Text = msg t2.Font = Enum.Font.Gotham t2.TextSize = 10
	t2.TextColor3 = Colors.TextMain t2.TextXAlignment = Enum.TextXAlignment.Left t2.TextTruncate = Enum.TextTruncate.AtEnd

	task.delay(2.4, function()
		if card and card.Parent then
			tween(card, 0.2, {BackgroundTransparency = 1})
			tween(t1, 0.2, {TextTransparency = 1})
			tween(t2, 0.2, {TextTransparency = 1})
			tween(st, 0.2, {Transparency = 1})
			task.wait(0.22)
			if card then card:Destroy() end
		end
	end)
end

