local function getClosestTargetInFOV()
	local bestTarget = nil
	local shortestDist = State.AimFOV
	local viewportCenter = camera.ViewportSize / 2

	for _, t in ipairs(GetCombatTargets()) do
		if State.AimTeamCheck and t.Team ~= nil and t.Team == player.Team then continue end
		local hum = t.Char:FindFirstChildOfClass("Humanoid")
		local targetPart = t.Char:FindFirstChild(State.AimTargetPart) or t.Char:FindFirstChild("HumanoidRootPart")
		if hum and hum.Health > 0 and targetPart then
			local finalPos = targetPart.Position
			-- Prediction Berechnung (Vorausschau)
			if State.Prediction and targetPart.AssemblyLinearVelocity then
				finalPos += targetPart.AssemblyLinearVelocity * State.PredictionFactor
			end

			local screenPos, onScreen = camera:WorldToViewportPoint(finalPos)
			if onScreen then
				local dist2D = (Vector2.new(screenPos.X, screenPos.Y) - viewportCenter).Magnitude
				if dist2D <= shortestDist then
					if State.AimWallCheck then
						local rayParams = RaycastParams.new()
						local ignoreList = {camera}
						if Env.CachedChar then table.insert(ignoreList, Env.CachedChar) end
						rayParams.FilterDescendantsInstances = ignoreList
						rayParams.FilterType = Enum.RaycastFilterType.Exclude
						local rayResult = workspace:Raycast(camera.CFrame.Position, finalPos - camera.CFrame.Position, rayParams)
						if rayResult and not rayResult.Instance:IsDescendantOf(t.Char) then continue end
					end
					shortestDist = dist2D
					bestTarget = {Part = targetPart, Position = finalPos, Hum = hum, Data = t}
				end
			end
		end
	end
	return bestTarget
end

-- Visuelle ESP-Erweiterungen (2D Box, Health Bar, Skeleton, Off-Screen)
local function updateESPAndHitboxes()
	UI.boxContainer:ClearAllChildren()
	UI.skeletonContainer:ClearAllChildren()
	UI.offScreenContainer:ClearAllChildren()

	local activeIds = {}
	local vp = camera.ViewportSize

	for _, t in ipairs(GetCombatTargets()) do
		activeIds[t.Id] = true
		local char = t.Char
		local hum = char:FindFirstChildOfClass("Humanoid")
		local hrp = char:FindFirstChild("HumanoidRootPart")
		local head = char:FindFirstChild("Head")

		local pFolder = UI.espFolder:FindFirstChild(t.Id)
		if not pFolder then
			pFolder = Instance.new("Folder", UI.espFolder)
			pFolder.Name = t.Id
		end

		if hum and hum.Health > 0 and hrp then
			local espColor = t.Color

			-- 3D Chams
			local hl = pFolder:FindFirstChild("ChamsHighlight")
			if State.ESPChams and not State.Streamproof then
				if not hl then
					hl = Instance.new("Highlight", pFolder)
					hl.Name = "ChamsHighlight" hl.FillTransparency = 0.65 hl.OutlineTransparency = 0.1
					hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
				end
				hl.Adornee = char hl.FillColor = espColor hl.OutlineColor = Color3.new(1, 1, 1) hl.Enabled = true
			elseif hl then
				hl.Enabled = false
			end

			-- 2D Box & Health Bar
			if (State.ESPBox2D or State.ESPHealthBar) and not State.Streamproof then
				local cf, size = char:GetBoundingBox()
				local screenPos, onScreen = camera:WorldToViewportPoint(cf.Position)
				if onScreen then
					local scale = 2500 / (camera.CFrame.Position - cf.Position).Magnitude
					local w, h = math.clamp(18 * scale, 12, 350), math.clamp(32 * scale, 20, 500)
					local boxX, boxY = screenPos.X - w / 2, screenPos.Y - h / 2

					if State.ESPBox2D then
						local box = Instance.new("Frame", UI.boxContainer)
						box.Position = UDim2.new(0, boxX, 0, boxY)
						box.Size = UDim2.new(0, w, 0, h)
						box.BackgroundTransparency = 1
						stroke(box, espColor, 1.2)
					end

					if State.ESPHealthBar then
						local hpPct = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
						local hbBg = Instance.new("Frame", UI.boxContainer)
						hbBg.Position = UDim2.new(0, boxX - 5, 0, boxY)
						hbBg.Size = UDim2.new(0, 3, 0, h)
						hbBg.BackgroundColor3 = Color3.fromRGB(40, 40, 40) hbBg.BorderSizePixel = 0

						local hbFill = Instance.new("Frame", hbBg)
						hbFill.Position = UDim2.new(0, 0, 1 - hpPct, 0)
						hbFill.Size = UDim2.new(1, 0, hpPct, 0)
						hbFill.BackgroundColor3 = Color3.fromRGB(45, 220, 85) hbFill.BorderSizePixel = 0
					end
				end
			end

			-- Skeleton ESP (Bones)
			if State.ESPSkeleton and not State.Streamproof then
				local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
				local leftArm = char:FindFirstChild("Left Arm") or char:FindFirstChild("LeftHand")
				local rightArm = char:FindFirstChild("Right Arm") or char:FindFirstChild("RightHand")
				local leftLeg = char:FindFirstChild("Left Leg") or char:FindFirstChild("LeftFoot")
				local rightLeg = char:FindFirstChild("Right Leg") or char:FindFirstChild("RightFoot")

				local function drawBone(p1, p2)
					if p1 and p2 then
						local s1, o1 = camera:WorldToViewportPoint(p1.Position)
						local s2, o2 = camera:WorldToViewportPoint(p2.Position)
						if o1 and o2 then
							local diff = Vector2.new(s2.X - s1.X, s2.Y - s1.Y)
							local line = Instance.new("Frame", UI.skeletonContainer)
							line.AnchorPoint = Vector2.new(0.5, 0.5)
							line.Position = UDim2.new(0, (s1.X + s2.X) / 2, 0, (s1.Y + s2.Y) / 2)
							line.Size = UDim2.new(0, diff.Magnitude, 0, 1.5)
							line.Rotation = math.deg(math.atan2(diff.Y, diff.X))
							line.BackgroundColor3 = espColor line.BorderSizePixel = 0
						end
					end
				end

				if head and torso then drawBone(head, torso) end
				if torso and leftArm then drawBone(torso, leftArm) end
				if torso and rightArm then drawBone(torso, rightArm) end
				if torso and leftLeg then drawBone(torso, leftLeg) end
				if torso and rightLeg then drawBone(torso, rightLeg) end
			end

			-- Off-Screen Arrows
			if State.ESPOffScreen and not State.Streamproof then
				local screenPos, onScreen = camera:WorldToViewportPoint(hrp.Position)
				if not onScreen then
					local center = Vector2.new(vp.X / 2, vp.Y / 2)
					local dir = (Vector2.new(screenPos.X, screenPos.Y) - center).Unit
					local arrowPos = center + dir * math.min(vp.X, vp.Y) * 0.38
					local arrow = Instance.new("TextLabel", UI.offScreenContainer)
					arrow.Size = UDim2.new(0, 24, 0, 24)
					arrow.AnchorPoint = Vector2.new(0.5, 0.5)
					arrow.Position = UDim2.new(0, arrowPos.X, 0, arrowPos.Y)
					arrow.BackgroundTransparency = 1 arrow.Text = "▲"
					arrow.Font = Enum.Font.GothamBold arrow.TextSize = 14 arrow.TextColor3 = espColor
					arrow.Rotation = math.deg(math.atan2(dir.Y, dir.X)) + 90
				end
			end

			-- Overhead Nametags
			local bb = pFolder:FindFirstChild("NametagBillboard")
			if State.ESPNametags and not State.Streamproof and head then
				if not bb then
					bb = Instance.new("BillboardGui", pFolder)
					bb.Name = "NametagBillboard" bb.Size = UDim2.new(0, 160, 0, 36) bb.StudsOffset = Vector3.new(0, 2.8, 0) bb.AlwaysOnTop = true
					local tagLbl = Instance.new("TextLabel", bb)
					tagLbl.Name = "InfoLabel" tagLbl.Size = UDim2.new(1, 0, 1, 0) tagLbl.BackgroundTransparency = 1
					tagLbl.Font = Enum.Font.GothamBold tagLbl.TextSize = 11 tagLbl.TextStrokeTransparency = 0.35
				end
				bb.Adornee = head bb.Enabled = true
				local dist = Env.CachedRoot and math.floor((hrp.Position - Env.CachedRoot.Position).Magnitude) or 0
				local infoLbl = bb:FindFirstChild("InfoLabel")
				if infoLbl then
					infoLbl.TextColor3 = espColor
					infoLbl.Text = string.format("%s [%d HP]\n%d Studs", t.Name, math.floor(hum.Health), dist)
				end
			elseif bb then
				bb.Enabled = false
			end

			if State.HitboxExpander then
				hrp.Size = Vector3.new(State.HitboxSize, State.HitboxSize, State.HitboxSize)
				hrp.Transparency = 0.65 hrp.Color = espColor hrp.CanCollide = false
			end
		else
			pFolder:ClearAllChildren()
		end
	end

	for _, child in ipairs(UI.espFolder:GetChildren()) do
		if not activeIds[child.Name] then child:Destroy() end
	end
end

