			local look = camera.CFrame.LookVector
			local deg = math.deg(math.atan2(-look.X, -look.Z)) % 360
			local dir = dirs[math.floor((deg + 22.5) / 45) % 8 + 1]
			UI.compassLbl.Text = string.format("%s (%.0f°) • %.0f, %.0f, %.0f", dir, deg, Env.CachedRoot.Position.X, Env.CachedRoot.Position.Y, Env.CachedRoot.Position.Z)
		end
	end
end)

local function FullCleanup()
	State.Running = false State.Fly = false State.ZeroG = false
	cleanupFlyConstraints() updateZeroG() resetHitboxes() applyBodyMaterial(false)
	if Env.airWalkPart then Env.airWalkPart:Destroy() Env.airWalkPart = nil end
	if UI.ghostFolder then UI.ghostFolder:Destroy() end
	for _, d in ipairs(Env.spawnedDummies) do if d then d:Destroy() end end
	for part, orig in pairs(Env.invisWallsOriginal) do if part and part.Parent then part.LocalTransparencyModifier = orig end end
	for part, orig in pairs(Env.xrayOriginal) do if part and part.Parent then part.LocalTransparencyModifier = orig end end

	Svc.Lighting.Brightness = Env.OrigLighting.Brightness Svc.Lighting.ClockTime = Env.OrigLighting.ClockTime
	Svc.Lighting.FogEnd = Env.OrigLighting.FogEnd Svc.Lighting.GlobalShadows = Env.OrigLighting.GlobalShadows
	Svc.Lighting.Ambient = Env.OrigLighting.Ambient Svc.Lighting.OutdoorAmbient = Env.OrigLighting.OutdoorAmbient
	workspace.Gravity = Env.OrigLighting.Gravity player.CameraMaxZoomDistance = Env.OrigLighting.MaxZoom

	for _, c in ipairs(Env.Connections) do if c.Connected then c:Disconnect() end end
	table.clear(Env.Connections)

	if Env.CachedRoot then Env.CachedRoot.Anchored = false Env.CachedRoot.AssemblyAngularVelocity = Vector3.zero end
	if Env.CachedHum then Env.CachedHum.WalkSpeed = 16 Env.CachedHum.JumpPower = 50 Env.CachedHum.PlatformStand = false Env.CachedHum.Sit = false camera.CameraSubject = Env.CachedHum end
	for _, p in ipairs(Env.CachedParts) do if p and p.Parent then p.CanCollide = true end end
	for _, item in ipairs(Env.deletedStack) do if item.Part then item.Part.Parent = item.Parent end end

	camera.CameraType = Enum.CameraType.Custom camera.FieldOfView = 70
	if UI.menuBlur then UI.menuBlur:Destroy() end
	if UI.dofEffect then UI.dofEffect:Destroy() end
	if UI.ccShader then UI.ccShader:Destroy() end
	if UI.gui then UI.gui:Destroy() end
end

TrackConn(Svc.UIS.InputBegan:Connect(function(inp, gp)
	if gp then return end

	if Env.BindingToggleObj and inp.UserInputType == Enum.UserInputType.Keyboard then
		if inp.KeyCode == Enum.KeyCode.Escape or inp.KeyCode == Enum.KeyCode.Backspace then
			Env.BindingToggleObj.Key = nil Env.BindingToggleObj.BindBtn.Text = "[...]" Env.BindingToggleObj.BindBtn.TextColor3 = Colors.TextMuted
		else
			Env.BindingToggleObj.Key = inp.KeyCode Env.BindingToggleObj.BindBtn.Text = "[" .. inp.KeyCode.Name:sub(1, 3) .. "]" Env.BindingToggleObj.BindBtn.TextColor3 = Colors.Accent
			Notify("Keybind", Env.BindingToggleObj.Label .. " gebunden auf [" .. inp.KeyCode.Name .. "]", "Success")
		end
		Env.BindingToggleObj = nil refreshKeybindOverlay()
		return
	end

	if inp.KeyCode == Brand.ToggleKey then
		UI.mainContainer.Visible = not UI.mainContainer.Visible
		UI.menuBlur.Size = (UI.mainContainer.Visible and not State.Streamproof) and State.BlurSize or 0
	elseif inp.KeyCode == Brand.CommandKey and Svc.UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
		UI.cmdModal.Visible = not UI.cmdModal.Visible
		if UI.cmdModal.Visible then UI.cmdBox:CaptureFocus() end
	elseif inp.KeyCode == Brand.StreamproofKey then
		State.Streamproof = not State.Streamproof
		UI.masterRoot.Visible = not State.Streamproof
		UI.fovCircle.Visible = State.ShowFOVCircle and not State.Streamproof
		UI.radarFrame.Visible = State.ShowRadar and not State.Streamproof
		UI.keybindOverlay.Visible = State.ShowKeybindList and not State.Streamproof
		UI.crosshairHolder.Visible = State.CustomCrosshair and not State.Streamproof
		UI.menuBlur.Size = (UI.mainContainer.Visible and not State.Streamproof) and State.BlurSize or 0
	elseif inp.KeyCode == Brand.PanicKey then
		FullCleanup()
		return
	end

	if inp.UserInputType == Enum.UserInputType.Keyboard then
		for _, tObj in ipairs(Env.CustomKeybinds) do
			if tObj.Key and tObj.Key == inp.KeyCode then
				playUISound() tObj.Set(not tObj.Get())
			end
		end
	end
end))

local function makeDrag(handle, target)
	local drag, dInp, dStart, sPos
	handle.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			drag = true dStart = i.Position sPos = target.Position
			i.Changed:Connect(function() if i.UserInputState == Enum.UserInputState.End then drag = false end end)
		end
	end)
	handle.InputChanged:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then dInp = i end
	end)
	TrackConn(Svc.UIS.InputChanged:Connect(function(i)
		if i == dInp and drag then
			local d = i.Position - dStart
			target.Position = UDim2.new(sPos.X.Scale, sPos.X.Offset + d.X, sPos.Y.Scale, sPos.Y.Offset + d.Y)
		end
	end))
end

