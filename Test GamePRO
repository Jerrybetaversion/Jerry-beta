local function CreateButtonRow(parent, buttonsList, customHeight)
	local row = Instance.new("Frame", parent)
	row.Size = UDim2.new(1, 0, 0, customHeight or 40)
	row.BackgroundTransparency = 1

	local holder = Instance.new("Frame", row)
	holder.Size = UDim2.new(1, -24, 0, (customHeight or 40) - 8)
	holder.Position = UDim2.new(0, 12, 0, 4)
	holder.BackgroundTransparency = 1

	local count = #buttonsList
	local gap = 6
	for i, bInfo in ipairs(buttonsList) do
		local btn = Instance.new("TextButton", holder)
		local wScale = 1 / count
		btn.Size = UDim2.new(wScale, -((count - 1) * gap / count), 1, 0)
		btn.Position = UDim2.new(wScale * (i - 1), (i - 1) * (gap / count), 0, 0)
		btn.BackgroundColor3 = bInfo.Bg or Color3.fromRGB(19, 20, 26)
		btn.Text = ""
		corner(btn, 5)
		stroke(btn, Colors.Stroke, 1)

		if bInfo.Icon then
			local inner = Instance.new("Frame", btn)
			inner.Size = UDim2.new(1, 0, 1, 0) inner.BackgroundTransparency = 1
			local il = Instance.new("UIListLayout", inner)
			il.FillDirection = Enum.FillDirection.Horizontal
			il.HorizontalAlignment = Enum.HorizontalAlignment.Center
			il.VerticalAlignment = Enum.VerticalAlignment.Center
			il.Padding = UDim.new(0, 5)

			local ic = Instance.new("TextLabel", inner)
			ic.Size = UDim2.new(0, 14, 0, 14) ic.BackgroundTransparency = 1
			ic.Text = bInfo.Icon ic.Font = Enum.Font.GothamBold ic.TextSize = 11
			ic.TextColor3 = bInfo.IconCol or Colors.Accent
			if not bInfo.IconCol then table.insert(Env.AccentTexts, ic) end

			local tx = Instance.new("TextLabel", inner)
			tx.Size = UDim2.new(0, 0, 1, 0) tx.AutomaticSize = Enum.AutomaticSize.X
			tx.BackgroundTransparency = 1 tx.Text = bInfo.Text
			tx.Font = Enum.Font.GothamMedium tx.TextSize = 11 tx.TextColor3 = Colors.TextMain
		else
			btn.Text = bInfo.Text
			btn.Font = Enum.Font.GothamMedium
			btn.TextSize = 11
			btn.TextColor3 = Colors.TextMain
		end

		btn.MouseButton1Click:Connect(function()
			playUISound()
			if bInfo.OnClick then bInfo.OnClick() end
		end)
	end
	return row
end

