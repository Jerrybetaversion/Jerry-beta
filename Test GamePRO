			refreshKeybindOverlay()
		else
			Env.BindingToggleObj = obj
			bindBtn.Text = "[?]"
			bindBtn.TextColor3 = Colors.Accent
		end
	end)

	row.MouseButton1Click:Connect(function() playUISound() obj.Set(not state) end)
	RegisterQuickCmd(labelText, function() obj.Set(not state) end)
	return obj
end

