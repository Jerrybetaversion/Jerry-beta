local function Get2DBoundingBox(hrp)
	local cf = hrp.CFrame
	local size = Vector3.new(4.2, 5.8, 2.5)
	local minX, minY = math.huge, math.huge
	local maxX, maxY = -math.huge, -math.huge
	local anyVisible = false

	for x = -0.5, 0.5, 1 do
		for y = -0.5, 0.5, 1 do
			for z = -0.5, 0.5, 1 do
				local worldPt = (cf * CFrame.new(x * size.X, y * size.Y, z * size.Z)).Position
				local screenPt, onScreen = camera:WorldToViewportPoint(worldPt)
				if screenPt.Z > 0 then
					if onScreen then anyVisible = true end
					if screenPt.X < minX then minX = screenPt.X end
					if screenPt.X > maxX then maxX = screenPt.X end
					if screenPt.Y < minY then minY = screenPt.Y end
					if screenPt.Y > maxY then maxY = screenPt.Y end
				end
			end
		end
	end

	if not anyVisible then return nil end
	return minX, minY, math.clamp(maxX - minX, 8, 600), math.clamp(maxY - minY, 12, 800)
end

local function IsTargetVisible(char, part)
	local rayParams = RaycastParams.new()
	local ignoreList = {camera}
	if Env.CachedChar then table.insert(ignoreList, Env.CachedChar) end
	rayParams.FilterDescendantsInstances = ignoreList
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	local res = workspace:Raycast(camera.CFrame.Position, part.Position - camera.CFrame.Position, rayParams)
	return (res == nil) or res.Instance:IsDescendantOf(char)
end

local function SetLine(frame, x1, y1, x2, y2, col, thick)
	local dx, dy = x2 - x1, y2 - y1
	local len = math.sqrt(dx * dx + dy * dy)
	if len < 1 then frame.Visible = false return end
	frame.Position = UDim2.new(0, (x1 + x2) * 0.5, 0, (y1 + y2) * 0.5)
	frame.Size = UDim2.new(0, len, 0, thick)
	frame.Rotation = math.deg(math.atan2(dy, dx))
	frame.BackgroundColor3 = col
	frame.Visible = true
end

local function RenderSmoothESP()
	if not State.MasterESP or State.Streamproof then
		for _, node in pairs(Env.ESPPool) do HideESPNode(node) end
		return
	end

	local seenIds = {}
	local vp = camera.ViewportSize
	local vpCenter = Vector2.new(vp.X * 0.5, vp.Y * 0.5)
	local thick = State.ESPThickness
	local strokeTrans = 1 - (State.TextOutline / 100)
	local tracerStart = Vector2.new(vp.X * 0.5, vp.Y - 8)

	for _, t in ipairs(GetCombatTargets()) do
		seenIds[t.Id] = true
		local node = Env.ESPPool[t.Id] or CreateESPNode(t.Id)
		local char = t.Char
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local head = char and char:FindFirstChild("Head")

		if hum and hrp and (hum.Health > 0 or State.ESPShowDead) then
			local dist = math.floor((camera.CFrame.Position - hrp.Position).Magnitude / 3.2)
			if dist <= State.MaxESPDistance then
				if State.HitboxExpander and not t.IsNPC then
					hrp.Size = Vector3.new(State.HitboxSize, State.HitboxSize, State.HitboxSize)
					hrp.Transparency = State.HitboxTransparency / 100
					hrp.CanCollide = false
				end

				local boxCol = t.TeamColor or State.ColBox
				local skelCol = t.TeamColor or State.ColSkeleton

				if State.ESPChams then
					node.Chams.Adornee = char
					node.Chams.FillColor = State.ColChams
					node.Chams.FillTransparency = State.ChamsFillTrans / 100
					node.Chams.OutlineColor = Color3.new(1, 1, 1)
					node.Chams.Enabled = true
				else
					node.Chams.Enabled = false
				end

				local bx, by, bw, bh = Get2DBoundingBox(hrp)
				if bx then
					node.Arrow.Visible = false

					-- 2D Box
					if State.ESPBox2D then
						if State.ESPBoxStyle == "Corner" then
							node.BoxMain.Visible = false
							local cLenW = math.max(4, math.floor(bw * 0.25))
							local cLenH = math.max(4, math.floor(bh * 0.22))
							local c = node.Corners
							c[1].Position = UDim2.new(0, bx, 0, by) c[1].Size = UDim2.new(0, cLenW, 0, thick)
							c[2].Position = UDim2.new(0, bx, 0, by) c[2].Size = UDim2.new(0, thick, 0, cLenH)
							c[3].Position = UDim2.new(0, bx + bw - cLenW, 0, by) c[3].Size = UDim2.new(0, cLenW, 0, thick)
							c[4].Position = UDim2.new(0, bx + bw - thick, 0, by) c[4].Size = UDim2.new(0, thick, 0, cLenH)
							c[5].Position = UDim2.new(0, bx, 0, by + bh - thick) c[5].Size = UDim2.new(0, cLenW, 0, thick)
							c[6].Position = UDim2.new(0, bx, 0, by + bh - cLenH) c[6].Size = UDim2.new(0, thick, 0, cLenH)
							c[7].Position = UDim2.new(0, bx + bw - cLenW, 0, by + bh - thick) c[7].Size = UDim2.new(0, cLenW, 0, thick)
							c[8].Position = UDim2.new(0, bx + bw - thick, 0, by + bh - cLenH) c[8].Size = UDim2.new(0, thick, 0, cLenH)
							for i = 1, 8 do c[i].BackgroundColor3 = boxCol c[i].Visible = true end
						else
							for i = 1, 8 do node.Corners[i].Visible = false end
							node.BoxMain.Position = UDim2.new(0, bx, 0, by)
							node.BoxMain.Size = UDim2.new(0, bw, 0, bh)
							node.BoxStroke.Color = boxCol
							node.BoxStroke.Thickness = thick
							node.BoxMain.Visible = true
						end
					else
						node.BoxMain.Visible = false
						for i = 1, 8 do node.Corners[i].Visible = false end
					end

					-- Health Bar (Standardmäßig UNTEN horizontal wie auf Screenshot 1)
					local bottomCursorY = by + bh + 4
					if State.ESPHealthBar then
						local hpPct = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
						if State.HealthBarPos == "Bottom" then
							local barW = math.clamp(bw * 0.85, 42, 120)
							node.HealthBg.Position = UDim2.new(0, bx + (bw - barW) * 0.5, 0, bottomCursorY)
							node.HealthBg.Size = UDim2.new(0, barW, 0, 4)
							node.HealthFill.Position = UDim2.new(0, 0, 0, 0)
							node.HealthFill.Size = UDim2.new(hpPct, 0, 1, 0)
							bottomCursorY = bottomCursorY + 6
						else
							node.HealthBg.Position = UDim2.new(0, bx - 6, 0, by)
							node.HealthBg.Size = UDim2.new(0, 3, 0, bh)
							node.HealthFill.Position = UDim2.new(0, 0, 1 - hpPct, 0)
							node.HealthFill.Size = UDim2.new(1, 0, hpPct, 0)
						end
						node.HealthFill.BackgroundColor3 = State.ColHealth
						node.HealthBg.Visible = true
					else
						node.HealthBg.Visible = false
					end

					-- Armor Bar
					if State.ESPArmorBar then
						local barW = math.clamp(bw * 0.85, 42, 120)
						node.ArmorBg.Position = UDim2.new(0, bx + (bw - barW) * 0.5, 0, bottomCursorY)
						node.ArmorBg.Size = UDim2.new(0, barW, 0, 3)
						node.ArmorFill.Size = UDim2.new(1, 0, 1, 0)
						node.ArmorFill.BackgroundColor3 = State.ColArmor
						node.ArmorBg.Visible = true
						bottomCursorY = bottomCursorY + 5
					else
						node.ArmorBg.Visible = false
					end

					-- Distanz ("4m") & Name ("m4ryr0") untereinander unter dem Balken (Wie Screenshot 1)
					if State.ESPDistance then
						node.DistLabel.Text = string.format("%dm", dist)
						node.DistLabel.TextColor3 = State.ColDist
						node.DistLabel.TextStrokeTransparency = strokeTrans
						node.DistLabel.Position = UDim2.new(0, bx + bw * 0.5 - 80, 0, bottomCursorY)
						node.DistLabel.Size = UDim2.new(0, 160, 0, 13)
						node.DistLabel.Visible = true
						bottomCursorY = bottomCursorY + 12
					else
						node.DistLabel.Visible = false
					end

					if State.ESPNametags then
						node.NameLabel.Text = string.lower(t.Name)
						node.NameLabel.TextColor3 = State.ColName
						node.NameLabel.TextStrokeTransparency = strokeTrans
						node.NameLabel.Position = UDim2.new(0, bx + bw * 0.5 - 80, 0, bottomCursorY)
						node.NameLabel.Size = UDim2.new(0, 160, 0, 13)
						node.NameLabel.Visible = true
					else
						node.NameLabel.Visible = false
					end

					-- Kleines rotes/pinkes Kopf-Tag oben (Wie auf Screenshot 1 am Kopf des Spielers)
					if State.ESPWeapon and head then
						local hPos, hVis = camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
						if hVis then
							local tool = char:FindFirstChildOfClass("Tool")
							node.HeadTag.Text = tool and tool.Name or ("ID: " .. tostring(t.ServerIndex or 1))
							node.HeadTag.TextColor3 = State.ColLook
							node.HeadTag.Position = UDim2.new(0, hPos.X - 60, 0, hPos.Y - 12)
							node.HeadTag.Size = UDim2.new(0, 120, 0, 12)
							node.HeadTag.Visible = true
						else
							node.HeadTag.Visible = false
						end
					else
						node.HeadTag.Visible = false
					end

					if State.ESPTracers then
						SetLine(node.Tracer, tracerStart.X, tracerStart.Y, bx + bw * 0.5, by + bh, State.ColTracer, thick)
					else
						node.Tracer.Visible = false
					end

					-- Pinkes R15/R6 Skeleton (Exakt wie auf Screenshot 1)
					if State.ESPSkeleton then
						local isR15 = char:FindFirstChild("UpperTorso") ~= nil
						local bonePairs = isR15 and R15_BONES or R6_BONES
						for i = 1, 14 do
							local pair = bonePairs[i]
							if pair then
								local p1 = char:FindFirstChild(pair[1])
								local p2 = char:FindFirstChild(pair[2])
								if p1 and p2 then
									local s1, o1 = camera:WorldToViewportPoint(p1.Position)
									local s2, o2 = camera:WorldToViewportPoint(p2.Position)
									if o1 and o2 then
										SetLine(node.Bones[i], s1.X, s1.Y, s2.X, s2.Y, skelCol, thick)
									else
										node.Bones[i].Visible = false
									end
								else
									node.Bones[i].Visible = false
								end
							else
								node.Bones[i].Visible = false
							end
						end
					else
						for i = 1, 14 do node.Bones[i].Visible = false end
					end
				else
					HideESPNode(node)
				end
			else
				HideESPNode(node)
			end
		else
			HideESPNode(node)
		end
	end

	for id, node in pairs(Env.ESPPool) do
		if not seenIds[id] then
			if node.Folder then node.Folder:Destroy() end
			if node.Chams then node.Chams:Destroy() end
			Env.ESPPool[id] = nil
		end
	end
end

