	for _, t in ipairs(GetCombatTargets()) do
		if t.Char == Env.CachedChar then continue end
		if State.AimTeamCheck and t.Team ~= nil and t.Team == player.Team then continue end
		local hum = t.Char:FindFirstChildOfClass("Humanoid")
		local hrp = t.Char:FindFirstChild("HumanoidRootPart")

		if hum and hum.Health > 0 and hrp then
			local worldDist = (hrp.Position - camera.CFrame.Position).Magnitude
			if worldDist > State.MaxAimDistance then continue end

			local targetPart = t.Char:FindFirstChild(State.AimTargetPart) or hrp
			if State.ClosestBone then
				local bestBoneDist = math.huge
				for _, bName in ipairs(BONE_LIST) do
					local bp = t.Char:FindFirstChild(bName)
					if bp then
						local sp, vis = camera:WorldToViewportPoint(bp.Position)
						if vis then
							local d = (Vector2.new(sp.X, sp.Y) - viewportCenter).Magnitude
							if d < bestBoneDist then bestBoneDist = d targetPart = bp end
						end
					end
				end
			end

			local finalPos = targetPart.Position
			if State.Prediction and targetPart.AssemblyLinearVelocity then
				finalPos += targetPart.AssemblyLinearVelocity * State.PredictionFactor
			end

			local screenPos, onScreen = camera:WorldToViewportPoint(finalPos)
			if onScreen then
				local dist2D = (Vector2.new(screenPos.X, screenPos.Y) - viewportCenter).Magnitude
				if dist2D <= State.AimFOV then
					if State.AimWallCheck and not IsTargetVisible(t.Char, targetPart) then continue end
					local score = (State.AimPriority == "Distance" and worldDist) or (State.AimPriority == "Lowest HP" and hum.Health) or dist2D
					if score < bestScore then
						bestScore = score
						bestTarget = {Part = targetPart, Position = finalPos, Hum = hum, Data = t}
					end
				end
			end
		end
	end
	return bestTarget
end

