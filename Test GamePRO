	lbl.TextColor3 = Colors.TextMain lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.TextTruncate = Enum.TextTruncate.AtEnd

	local bindBtn = Instance.new("TextButton", row)
	bindBtn.Size = UDim2.new(0, 32, 0, 17) bindBtn.Position = UDim2.new(1, -70, 0.5, -8)
	bindBtn.BackgroundColor3 = Colors.ElementBg bindBtn.Text = "[...]"
	bindBtn.Font = Enum.Font.Code bindBtn.TextSize = 9 bindBtn.TextColor3 = Colors.TextMuted
	corner(bindBtn, 5)

	local pill = Instance.new("Frame", row)
	pill.Size = UDim2.new(0, 34, 0, 17) pill.Position = UDim2.new(1, -34, 0.5, -8)
	pill.BackgroundColor3 = state and Colors.Accent or Colors.ElementBg
	corner(pill, 9)

	local dot = Instance.new("Frame", pill)
	dot.Size = UDim2.new(0, 13, 0, 13)
	dot.Position = state and UDim2.new(1, -15, 0.5, -6) or UDim2.new(0, 2, 0.5, -6)
	dot.BackgroundColor3 = Color3.new(1, 1, 1) corner(dot, 7)

	local obj = {Get = function() return state end, Pill = pill, Key = nil, BindBtn = bindBtn, Label = labelText}
	table.insert(AccentPills, obj)
	table.insert(CustomKeybinds, obj)
	AllTogglesMap[labelText] = obj

	function obj.Set(v)
		state = v
		pill.BackgroundColor3 = state and Colors.Accent or Colors.ElementBg
		tween(dot, 0.16, {Position = state and UDim2.new(1, -15, 0.5, -6) or UDim2.new(0, 2, 0.5, -6)})
		callback(state)
		refreshKeybindOverlay()
	end

	bindBtn.MouseButton1Click:Connect(function()
		playUISound()
		if BindingToggleObj == obj then
			obj.Key = nil
			bindBtn.Text = "[...]"
			bindBtn.TextColor3 = Colors.TextMuted
			BindingToggleObj = nil
			refreshKeybindOverlay()
		else
			BindingToggleObj = obj
			bindBtn.Text = "[?]"
			bindBtn.TextColor3 = Colors.Accent
		end
	end)

	row.MouseButton1Click:Connect(function() playUISound() obj.Set(not state) end)
	RegisterQuickCmd(labelText, function() obj.Set(not state) end)
	return obj
end

