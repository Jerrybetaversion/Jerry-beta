local function getClosestTargetInFOV()
	local bestTarget = nil
	local shortestDist = State.AimFOV
	local viewportCenter = camera.ViewportSize / 2

	for _, t in ipairs(GetCombatTargets()) do
		if State.AimTeamCheck and t.Team ~= nil and t.Team == player.Team then
			continue
		end
		local hum = t.Char:FindFirstChildOfClass("Humanoid")
		local targetPart = t.Char:FindFirstChild(State.AimTargetPart) or t.Char:FindFirstChild("HumanoidRootPart")
		if hum and hum.Health > 0 and targetPart then
			local screenPos, onScreen = camera:WorldToViewportPoint(targetPart.Position)
			if onScreen then
				local dist2D = (Vector2.new(screenPos.X, screenPos.Y) - viewportCenter).Magnitude
				if dist2D <= shortestDist then
					if State.AimWallCheck then
						local rayParams = RaycastParams.new()
						rayParams.FilterDescendantsInstances = {CachedChar or player.Character, camera}
						rayParams.FilterType = Enum.RaycastFilterType.Exclude
						local rayResult = workspace:Raycast(camera.CFrame.Position, targetPart.Position - camera.CFrame.Position, rayParams)
						if rayResult and not rayResult.Instance:IsDescendantOf(t.Char) then
							continue
						end
					end
					shortestDist = dist2D
					bestTarget = {Part = targetPart, Hum = hum, Data = t}
				end
			end
		end
	end
	return bestTarget
end

local function updateESPAndHitboxes()
	local activeIds = {}
	for _, t in ipairs(GetCombatTargets()) do
		activeIds[t.Id] = true
		local char = t.Char
		local hum = char:FindFirstChildOfClass("Humanoid")
		local hrp = char:FindFirstChild("HumanoidRootPart")
		local head = char:FindFirstChild("Head")

		local pFolder = espFolder:FindFirstChild(t.Id)
		if not pFolder then
			pFolder = Instance.new("Folder", espFolder)
			pFolder.Name = t.Id
		end

		if hum and hum.Health > 0 and hrp then
			local espColor = t.Color

			local hl = pFolder:FindFirstChild("ChamsHighlight")
			if State.ESPChams and not State.Streamproof then
				if not hl then
					hl = Instance.new("Highlight", pFolder)
					hl.Name = "ChamsHighlight"
					hl.FillTransparency = 0.65
					hl.OutlineTransparency = 0.1
					hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
				end
				hl.Adornee = char
				hl.FillColor = espColor
				hl.OutlineColor = Color3.new(1, 1, 1)
				hl.Enabled = true
			elseif hl then
				hl.Enabled = false
			end

			local bb = pFolder:FindFirstChild("NametagBillboard")
			if State.ESPNametags and not State.Streamproof and head then
				if not bb then
					bb = Instance.new("BillboardGui", pFolder)
					bb.Name = "NametagBillboard"
					bb.Size = UDim2.new(0, 160, 0, 36)
					bb.StudsOffset = Vector3.new(0, 2.8, 0)
					bb.AlwaysOnTop = true

					local tagLbl = Instance.new("TextLabel", bb)
					tagLbl.Name = "InfoLabel"
					tagLbl.Size = UDim2.new(1, 0, 1, 0)
					tagLbl.BackgroundTransparency = 1
					tagLbl.Font = Enum.Font.GothamBold
					tagLbl.TextSize = 11
					tagLbl.TextStrokeTransparency = 0.35
				end
				bb.Adornee = head
				bb.Enabled = true
				local dist = CachedRoot and math.floor((hrp.Position - CachedRoot.Position).Magnitude) or 0
				local infoLbl = bb:FindFirstChild("InfoLabel")
				if infoLbl then
					infoLbl.TextColor3 = espColor
					infoLbl.Text = string.format("%s [%d HP]\n%d Studs", t.Name, math.floor(hum.Health), dist)
				end
			elseif bb then
				bb.Enabled = false
			end

			if State.HitboxExpander then
				hrp.Size = Vector3.new(State.HitboxSize, State.HitboxSize, State.HitboxSize)
				hrp.Transparency = 0.65
				hrp.Color = espColor
				hrp.CanCollide = false
			end
		else
			pFolder:ClearAllChildren()
		end
	end

	for _, child in ipairs(espFolder:GetChildren()) do
		if not activeIds[child.Name] then child:Destroy() end
	end
end

