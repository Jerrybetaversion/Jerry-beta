local function IsFriendWithLocal(plr)
	if not plr or plr == player then return false end
	local ok, res = pcall(function() return player:IsFriendsWith(plr.UserId) end)
	return ok and res
end

local function GetAllEntities()
	local list = {}
	for idx, plr in ipairs(Svc.Players:GetPlayers()) do
		if (plr ~= player or State.ESPShowLocal) and plr.Character then
			table.insert(list, {
				Id = "Plr_" .. plr.UserId,
				ServerIndex = idx,
				Name = plr.DisplayName,
				PlayerObj = plr,
				Char = plr.Character,
				Team = plr.Team,
				TeamColor = (State.ESPTeamColors and plr.TeamColor) and plr.TeamColor.Color or nil,
				UserId = plr.UserId,
				IsNPC = false,
				IsFriend = IsFriendWithLocal(plr)
			})
		end
	end
	for i, d in ipairs(Env.spawnedDummies) do
		if d and d.Parent then
			table.insert(list, {
				Id = "Dummy_" .. i,
				ServerIndex = 100 + i,
				Name = d.Name,
				PlayerObj = nil,
				Char = d,
				Team = nil,
				TeamColor = nil,
				UserId = player.UserId,
				IsNPC = true,
				IsFriend = false
			})
		end
	end
	return list
end

