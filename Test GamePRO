local function getTargetRoot()
	if not State.SelectedTarget or not State.SelectedTarget.Char then return nil end
	return State.SelectedTarget.Char:FindFirstChild("HumanoidRootPart")
end

local targetSelectRows = {}
local function rebuildTargetSelector()
	for _, r in ipairs(targetSelectRows) do
		if r.Row then r.Row:Destroy() end
	end
	table.clear(targetSelectRows)

	for _, t in ipairs(GetCombatTargets()) do
		local _, _, row = gTargetSelect:Button("🎯 " .. t.Name, "Select", function()
			State.SelectedTarget = t
			selectedLbl.Text = "Ziel: " .. t.Name
			Notify("Player Hub", t.Name .. " als Ziel ausgewählt!", "Success")
		end)
		table.insert(targetSelectRows, {Row = row})
	end
end

