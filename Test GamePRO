local function GetCombatTargets()
	local list = {}
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player and plr.Character then
			table.insert(list, {
				Id = "Plr_" .. plr.UserId,
				Name = plr.DisplayName,
				Char = plr.Character,
				Team = plr.Team,
				Color = (State.ESPTeamColors and plr.TeamColor) and plr.TeamColor.Color or Colors.Accent,
				UserId = plr.UserId
			})
		end
	end
	for i, d in ipairs(spawnedDummies) do
		if d and d.Parent then
			table.insert(list, {
				Id = "Dummy_" .. i,
				Name = d.Name,
				Char = d,
				Team = nil,
				Color = Colors.Warning,
				UserId = player.UserId
			})
		end
	end
	return list
end

