local function FullCleanup()
	State.Running = false
	State.Fly = false
	State.ZeroG = false
	cleanupFlyConstraints()
	updateZeroG()
	resetHitboxes()
	applyBodyMaterial(false)

	if airWalkPart then airWalkPart:Destroy() airWalkPart = nil end
	if ghostFolder then ghostFolder:Destroy() end
	for _, d in ipairs(spawnedDummies) do if d then d:Destroy() end end
	for part, orig in pairs(invisWallsOriginal) do
		if part and part.Parent then part.LocalTransparencyModifier = orig end
	end
	for part, orig in pairs(xrayOriginal) do
		if part and part.Parent then part.LocalTransparencyModifier = orig end
	end

	Lighting.Brightness = OrigLighting.Brightness
	Lighting.ClockTime = OrigLighting.ClockTime
	Lighting.FogEnd = OrigLighting.FogEnd
	Lighting.GlobalShadows = OrigLighting.GlobalShadows
	Lighting.Ambient = OrigLighting.Ambient
	Lighting.OutdoorAmbient = OrigLighting.OutdoorAmbient
	workspace.Gravity = OrigLighting.Gravity
	player.CameraMaxZoomDistance = OrigLighting.MaxZoom

	for _, c in ipairs(Connections) do
		if c.Connected then c:Disconnect() end
	end
	table.clear(Connections)

	if CachedRoot then
		CachedRoot.Anchored = false
		CachedRoot.AssemblyAngularVelocity = Vector3.zero
	end
	if CachedHum then
		CachedHum.WalkSpeed = 16
		CachedHum.JumpPower = 50
		CachedHum.PlatformStand = false
		CachedHum.Sit = false
		camera.CameraSubject = CachedHum
	end
	for _, p in ipairs(CachedParts) do
		if p and p.Parent then p.CanCollide = true end
	end
	for _, item in ipairs(deletedStack) do
		if item.Part then item.Part.Parent = item.Parent end
	end

	camera.CameraType = Enum.CameraType.Custom
	camera.FieldOfView = 70
	if menuBlur then menuBlur:Destroy() end
	if dofEffect then dofEffect:Destroy() end
	if ccShader then ccShader:Destroy() end
	if gui then gui:Destroy() end
end

-- Hotkeys & Custom Keybind Handler
TrackConn(UserInputService.InputBegan:Connect(function(inp, gp)
	if gp then return end

	if BindingToggleObj and inp.UserInputType == Enum.UserInputType.Keyboard then
		if inp.KeyCode == Enum.KeyCode.Escape or inp.KeyCode == Enum.KeyCode.Backspace then
			BindingToggleObj.Key = nil
			BindingToggleObj.BindBtn.Text = "[...]"
			BindingToggleObj.BindBtn.TextColor3 = Colors.TextMuted
		else
			BindingToggleObj.Key = inp.KeyCode
			BindingToggleObj.BindBtn.Text = "[" .. inp.KeyCode.Name:sub(1, 3) .. "]"
			BindingToggleObj.BindBtn.TextColor3 = Colors.Accent
			Notify("Keybind", BindingToggleObj.Label .. " gebunden auf [" .. inp.KeyCode.Name .. "]", "Success")
		end
		BindingToggleObj = nil
		refreshKeybindOverlay()
		return
	end

	if inp.KeyCode == Brand.ToggleKey then
		mainContainer.Visible = not mainContainer.Visible
		menuBlur.Size = (mainContainer.Visible and not State.Streamproof) and State.BlurSize or 0
	elseif inp.KeyCode == Brand.CommandKey and UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
		cmdModal.Visible = not cmdModal.Visible
		if cmdModal.Visible then cmdBox:CaptureFocus() end
	elseif inp.KeyCode == Brand.StreamproofKey then
		State.Streamproof = not State.Streamproof
		masterRoot.Visible = not State.Streamproof
		fovCircle.Visible = State.ShowFOVCircle and not State.Streamproof
		radarFrame.Visible = State.ShowRadar and not State.Streamproof
		keybindOverlay.Visible = State.ShowKeybindList and not State.Streamproof
		crosshairHolder.Visible = State.CustomCrosshair and not State.Streamproof
		menuBlur.Size = (mainContainer.Visible and not State.Streamproof) and State.BlurSize or 0
	elseif inp.KeyCode == Brand.PanicKey then
		FullCleanup()
		return
	end

	if inp.UserInputType == Enum.UserInputType.Keyboard then
		for _, tObj in ipairs(CustomKeybinds) do
			if tObj.Key and tObj.Key == inp.KeyCode then
				playUISound()
				tObj.Set(not tObj.Get())
			end
		end
	end
end))

local function makeDrag(handle, target)
	local drag, dInp, dStart, sPos
	handle.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			drag = true dStart = i.Position sPos = target.Position
			i.Changed:Connect(function() if i.UserInputState == Enum.UserInputState.End then drag = false end end)
		end
	end)
	handle.InputChanged:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then dInp = i end
	end)
	TrackConn(UserInputService.InputChanged:Connect(function(i)
		if i == dInp and drag then
			local d = i.Position - dStart
			target.Position = UDim2.new(sPos.X.Scale, sPos.X.Offset + d.X, sPos.Y.Scale, sPos.Y.Offset + d.Y)
		end
	end))
end

