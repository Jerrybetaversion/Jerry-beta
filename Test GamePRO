local function CreateSlider(parent, labelText, min, max, default, suffix, callback, decimals)
	local holder = Instance.new("Frame", parent)
	holder.Size = UDim2.new(1, 0, 0, 48)
	holder.BackgroundTransparency = 1
	addBottomBorder(holder)

	local lbl = Instance.new("TextLabel", holder)
	lbl.Size = UDim2.new(0.65, 0, 0, 18) lbl.Position = UDim2.new(0, 12, 0, 6)
	lbl.BackgroundTransparency = 1
	lbl.Text = labelText lbl.Font = Enum.Font.GothamMedium lbl.TextSize = 11
	lbl.TextColor3 = Colors.TextMain lbl.TextXAlignment = Enum.TextXAlignment.Left

	local valPill = Instance.new("Frame", holder)
	valPill.Size = UDim2.new(0, 34, 0, 17)
	valPill.AutomaticSize = Enum.AutomaticSize.X
	valPill.AnchorPoint = Vector2.new(1, 0)
	valPill.Position = UDim2.new(1, -12, 0, 6)
	valPill.BackgroundColor3 = Colors.ElementBg
	corner(valPill, 4)
	stroke(valPill, Colors.Stroke, 1)

	local pillPad = Instance.new("UIPadding", valPill)
	pillPad.PaddingLeft = UDim.new(0, 6) pillPad.PaddingRight = UDim.new(0, 6)

	local valLbl = Instance.new("TextLabel", valPill)
	valLbl.Size = UDim2.new(0, 0, 1, 0)
	valLbl.AutomaticSize = Enum.AutomaticSize.X
	valLbl.BackgroundTransparency = 1
	valLbl.Font = Enum.Font.GothamBold valLbl.TextSize = 10
	valLbl.TextColor3 = Colors.TextMain

	local track = Instance.new("TextButton", holder)
	track.Size = UDim2.new(1, -24, 0, 4) track.Position = UDim2.new(0, 12, 0, 33)
	track.BackgroundColor3 = Colors.TrackBg track.Text = "" track.AutoButtonColor = false
	corner(track, 2)

	local fill = Instance.new("Frame", track)
	fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
	fill.BackgroundColor3 = Colors.Accent
	corner(fill, 2)
	table.insert(Env.AccentFills, fill)

	local knob = Instance.new("Frame", fill)
	knob.Size = UDim2.new(0, 11, 0, 11) knob.Position = UDim2.new(1, -5, 0.5, -5)
	knob.BackgroundColor3 = Colors.Accent corner(knob, 6)
	table.insert(Env.AccentFills, knob)

	local curVal = default
	local function formatVal(v)
		if decimals then
			return string.format("%." .. decimals .. "f", v) .. (suffix or "")
		end
		return tostring(math.floor(v + 0.5)) .. (suffix or "")
	end

	valLbl.Text = formatVal(default)

	local function setVal(v)
		if decimals then
			local mult = 10 ^ decimals
			curVal = math.clamp(math.floor(v * mult + 0.5) / mult, min, max)
		else
			curVal = math.clamp(math.floor(v + 0.5), min, max)
		end
		local r = (curVal - min) / (max - min)
		valLbl.Text = formatVal(curVal)
		fill.Size = UDim2.new(r, 0, 1, 0)
		callback(curVal)
	end

	local dragging = false
	local function update(inp)
		local r = math.clamp((inp.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		setVal(min + (max - min) * r)
	end

	track.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			playUISound() dragging = true update(i)
		end
	end)
	TrackConn(Svc.UIS.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
	end))
	TrackConn(Svc.UIS.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then update(i) end
	end))

	Env.AllSlidersMap[labelText] = {Get = function() return curVal end, Set = setVal}
	return holder
end

