		local hum = closestTarget.Hum
		local dist = Env.CachedRoot and math.floor((closestTarget.Part.Position - Env.CachedRoot.Position).Magnitude) or 0
		UI.thName.Text = "🎯 " .. closestTarget.Data.Name
