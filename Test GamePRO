local function TrackConn(conn)
	if conn then table.insert(Env.Connections, conn) end
	return conn
end

local function corner(p, r)
	local c = Instance.new("UICorner", p)
	c.CornerRadius = UDim.new(0, r or 6)
	return c
end

local function stroke(p, col, thick)
	local s = Instance.new("UIStroke", p)
	s.Color = col or Colors.Stroke
	s.Thickness = thick or 1
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	return s
end

local function tween(o, t, props)
	local tw = Svc.Tween:Create(o, TweenInfo.new(t, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

local function isPartOfMyChar(inst)
	return Env.CachedChar ~= nil and inst ~= nil and inst:IsDescendantOf(Env.CachedChar)
end

local function cleanupFlyConstraints()
	if Env.flyLv then Env.flyLv:Destroy() Env.flyLv = nil end
	if Env.flyAo then Env.flyAo:Destroy() Env.flyAo = nil end
	if Env.flyAtt then Env.flyAtt:Destroy() Env.flyAtt = nil end
	if Env.CachedHum and Env.CachedHum.PlatformStand then
		Env.CachedHum.PlatformStand = false
	end
end

local function updateZeroG()
	if not Env.CachedRoot then return end
	local existing = Env.CachedRoot:FindFirstChild("GameProZeroG")
	local existingAtt = Env.CachedRoot:FindFirstChild("GameProZeroGAtt")
	if State.ZeroG and not existing then
		local att = Instance.new("Attachment", Env.CachedRoot)
		att.Name = "GameProZeroGAtt"
		local vf = Instance.new("VectorForce", Env.CachedRoot)
		vf.Name = "GameProZeroG"
		vf.Attachment0 = att
		vf.RelativeTo = Enum.ActuatorRelativeTo.World
		vf.Force = Vector3.new(0, Env.CachedRoot.AssemblyMass * workspace.Gravity, 0)
	elseif not State.ZeroG then
		if existing then existing:Destroy() end
		if existingAtt then existingAtt:Destroy() end
	end
end

local function applyBodyMaterial(enable)
	if not Env.CachedChar then return end
	if enable then
		for _, p in ipairs(Env.CachedChar:GetDescendants()) do
			if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
				if not Env.OrigPartMaterials[p] then
					Env.OrigPartMaterials[p] = {Mat = p.Material, Col = p.Color}
				end
				p.Material = Enum.Material.ForceField
				p.Color = Colors.Accent
			end
		end
	else
		for p, data in pairs(Env.OrigPartMaterials) do
			if p and p.Parent then
				p.Material = data.Mat
				p.Color = data.Col
			end
		end
		table.clear(Env.OrigPartMaterials)
	end
end

local function refreshCharCache(char)
	cleanupFlyConstraints()
	Env.CachedChar = char
	Env.CachedParts = {}
	table.clear(Env.OrigPartMaterials)
	if not char then Env.CachedHum, Env.CachedRoot = nil, nil return end
	Env.CachedHum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 5)
	Env.CachedRoot = char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart", 5)
	for _, p in ipairs(char:GetDescendants()) do
		if p:IsA("BasePart") then table.insert(Env.CachedParts, p) end
	end

	if Env.CachedHum then
		TrackConn(Env.CachedHum.Died:Connect(function()
			if Env.CachedRoot then State.LastDeathCFrame = Env.CachedRoot.CFrame end
		end))
	end
	if State.AutoRespawnPos and State.LastDeathCFrame and Env.CachedRoot then
		task.wait(0.15)
		Env.CachedRoot.CFrame = State.LastDeathCFrame + Vector3.new(0, 3, 0)
	end
	if State.ZeroG then updateZeroG() end
	if State.ForcefieldBody then applyBodyMaterial(true) end
end

