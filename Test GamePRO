		popupHolder.Size = UDim2.new(1, 0, 0, 56)
		popupHolder.BackgroundColor3 = Color3.fromRGB(12, 12, 16)
		popupHolder.Visible = ps.OpenByDefault or false
		addBottomBorder(popupHolder)

