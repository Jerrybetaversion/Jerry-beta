local gDummy = SubCombat1:AddGroupbox("Right", "NPC Dummy-Spawner & Hitbox")
local function spawnTestDummy(patrol)
	if not CachedRoot then return end
	local model = Instance.new("Model", workspace)
	model.Name = patrol and ("PatrolDummy_" .. (#spawnedDummies + 1)) or ("TestDummy_" .. (#spawnedDummies + 1))

	local hum = Instance.new("Humanoid", model)
	hum.MaxHealth = 100 hum.Health = 100

	local spawnPos = CachedRoot.Position + (CachedRoot.CFrame.LookVector * 12) + Vector3.new(0, 3, 0)

	local hrp = Instance.new("Part", model)
	hrp.Name = "HumanoidRootPart"
	hrp.Size = Vector3.new(2, 2, 1)
	hrp.CFrame = CFrame.new(spawnPos)
	hrp.Anchored = false
	hrp.CanCollide = true
	hrp.Color = Colors.Accent
	hrp.Material = Enum.Material.SmoothPlastic

	local head = Instance.new("Part", model)
	head.Name = "Head"
	head.Size = Vector3.new(1.6, 1.6, 1.6)
	head.CFrame = hrp.CFrame * CFrame.new(0, 1.8, 0)
	head.CanCollide = true
	head.Color = Color3.fromRGB(245, 205, 150)
	head.Material = Enum.Material.SmoothPlastic
	local weld = Instance.new("WeldConstraint", hrp)
	weld.Part0 = hrp weld.Part1 = head

	model.PrimaryPart = hrp
	table.insert(spawnedDummies, model)
	rebuildTargetSelector()

	if patrol then
		hrp.Anchored = true
		task.spawn(function()
			local t = 0
			local rightVec = CachedRoot.CFrame.RightVector
			while State.Running and model and model.Parent and hum.Health > 0 do
				if not State.FreezeTarget then
					t += 0.04
					local offset = rightVec * (math.sin(t) * 10)
					hrp.CFrame = CFrame.new(spawnPos + offset)
				end
				task.wait(0.02)
			end
		end)
	end
	Notify("Dummy-Spawner", model.Name .. " gespawnt (Auch im Troll-Hub wählbar)!", "Success")
end

gDummy:Button("Physik-Dummy spawnen (Fling-bar)", "Spawn", function() spawnTestDummy(false) end)
gDummy:Button("Patrol-Dummy spawnen (Laufend)", "Patrol", function() spawnTestDummy(true) end)
gDummy:Button("Alle Dummies entfernen", "Clear", function()
