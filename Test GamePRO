local Categories = {}
local FirstCat = true

local function CreateCategory(icon, name)
	local btn = Instance.new("TextButton", navScroll)
	btn.Size = UDim2.new(1, 0, 0, 29) btn.BackgroundColor3 = Colors.GroupBg
	btn.BackgroundTransparency = 1 btn.Text = "  " .. icon .. "   " .. name
	btn.Font = Enum.Font.GothamMedium btn.TextSize = 11 btn.TextColor3 = Colors.TextMuted
	btn.TextXAlignment = Enum.TextXAlignment.Left btn.AutoButtonColor = false
	corner(btn, 7)

	local subTabs = {}
	local firstSub = true

	local function activateCategory()
		for _, c in ipairs(Categories) do
			c.Btn.BackgroundTransparency = 1 c.Btn.TextColor3 = Colors.TextMuted
			for _, st in ipairs(c.SubTabs) do st.Btn.Visible = false st.Page.Visible = false end
		end
		btn.BackgroundTransparency = 0 btn.TextColor3 = Colors.TextMain

		local activeSub = subTabs[1]
		for _, st in ipairs(subTabs) do
			st.Btn.Visible = true
			if st.Active then activeSub = st end
		end
		if activeSub then activeSub.Select() end
	end

	btn.MouseButton1Click:Connect(function() playUISound() activateCategory() end)
	table.insert(Categories, {Btn = btn, SubTabs = subTabs, Activate = activateCategory})

	local CatAPI = {}
	function CatAPI:AddSubTab(subIcon, subName)
		local sBtn = Instance.new("TextButton", subTabHolder)
		sBtn.Size = UDim2.new(0, 0, 0, 26) sBtn.AutomaticSize = Enum.AutomaticSize.X
		sBtn.BackgroundColor3 = Colors.GroupBg sBtn.BackgroundTransparency = 1
		sBtn.Text = " " .. subIcon .. " " .. subName .. " "
		sBtn.Font = Enum.Font.GothamBold sBtn.TextSize = 10 sBtn.TextColor3 = Colors.TextMuted
		sBtn.Visible = false corner(sBtn, 7)
		local sStroke = stroke(sBtn, Colors.Stroke, 1) sStroke.Enabled = false

		local page = Instance.new("Frame", pagesContainer)
		page.Size = UDim2.new(1, 0, 1, 0) page.BackgroundTransparency = 1 page.Visible = false

		local leftCol = Instance.new("ScrollingFrame", page)
		leftCol.Size = UDim2.new(0.49, 0, 1, 0) leftCol.BackgroundTransparency = 1
		leftCol.ScrollBarThickness = 2 leftCol.AutomaticCanvasSize = Enum.AutomaticSize.Y
		leftCol.CanvasSize = UDim2.new(0, 0, 0, 0)
		local lList = Instance.new("UIListLayout", leftCol) lList.Padding = UDim.new(0, 10)

		local rightCol = Instance.new("ScrollingFrame", page)
		rightCol.Size = UDim2.new(0.49, 0, 1, 0) rightCol.Position = UDim2.new(0.51, 0, 0, 0)
		rightCol.BackgroundTransparency = 1 rightCol.ScrollBarThickness = 2
		rightCol.AutomaticCanvasSize = Enum.AutomaticSize.Y rightCol.CanvasSize = UDim2.new(0, 0, 0, 0)
		local rList = Instance.new("UIListLayout", rightCol) rList.Padding = UDim.new(0, 10)

		local subEntry = {Btn = sBtn, Page = page, Active = firstSub, Stroke = sStroke}
		function subEntry.Select()
			for _, st in ipairs(subTabs) do
				st.Active = false st.Page.Visible = false
				st.Btn.BackgroundTransparency = 1 st.Btn.TextColor3 = Colors.TextMuted
				st.Stroke.Enabled = false
			end
			subEntry.Active = true page.Visible = true
			sBtn.BackgroundTransparency = 0 sBtn.TextColor3 = Colors.TextMain
			sStroke.Enabled = true
		end

		sBtn.MouseButton1Click:Connect(function() playUISound() subEntry.Select() end)
		table.insert(subTabs, subEntry)
		if firstSub then firstSub = false end

		local SubAPI = {}
		function SubAPI:AddGroupbox(column, title)
			local targetCol = (column == "Right") and rightCol or leftCol
			local box = Instance.new("Frame", targetCol)
			box.Size = UDim2.new(1, 0, 0, 0) box.AutomaticSize = Enum.AutomaticSize.Y
			box.BackgroundColor3 = Colors.GroupBg corner(box, 9) stroke(box, Colors.Stroke, 1)

			local pad = Instance.new("UIPadding", box)
			pad.PaddingTop = UDim.new(0, 9) pad.PaddingBottom = UDim.new(0, 11)
			pad.PaddingLeft = UDim.new(0, 11) pad.PaddingRight = UDim.new(0, 11)

			local boxLayout = Instance.new("UIListLayout", box) boxLayout.Padding = UDim.new(0, 7)

			local header = Instance.new("TextLabel", box)
			header.Size = UDim2.new(1, 0, 0, 16) header.BackgroundTransparency = 1
			header.Text = "◈  " .. title header.Font = Enum.Font.GothamBold header.TextSize = 11
			header.TextColor3 = Colors.TextMain header.TextXAlignment = Enum.TextXAlignment.Left

			local BoxAPI = {Frame = box}
			function BoxAPI:Slider(lbl, min, max, def, suf, cb) return CreateSlider(box, lbl, min, max, def, suf, cb) end
			function BoxAPI:Toggle(lbl, def, cb) return CreateToggle(box, lbl, def, cb) end
			function BoxAPI:Button(lbl, btnTxt, cb) return CreateButton(box, lbl, btnTxt, cb) end
			function BoxAPI:Input(ph, btnTxt, cb) return CreateInputRow(box, ph, btnTxt, cb) end
			return BoxAPI
		end
		return SubAPI
	end

	if FirstCat then FirstCat = false task.defer(activateCategory) end
	return CatAPI
end

