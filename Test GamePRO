	if State.ClickTP and Svc.UIS:IsKeyDown(Enum.KeyCode.LeftControl) and mouse.Hit and Env.CachedRoot then
		Env.CachedRoot.CFrame = CFrame.new(mouse.Hit.Position + Vector3.new(0, 3.2, 0))
	elseif State.KnockbackGun and target and not target.Anchored then
		local dir = (target.Position - camera.CFrame.Position).Unit
		target:ApplyImpulse(dir * target.AssemblyMass * 140 + Vector3.new(0, target.AssemblyMass * 60, 0))
	elseif State.LocalDeleteMode and target and not isPartOfMyChar(target) then
		table.insert(Env.deletedStack, {Part = target, Parent = target.Parent})
		target.Parent = nil
	end
end))

local lastTriggerShot = 0
local orbitAngle = 0
local fpsCount, lastFpsTick = 0, os.clock()

-- ============================================================================
-- HAUPT-RENDERSTEPPED ENGINE
-- ============================================================================
TrackConn(Svc.Run.RenderStepped:Connect(function(dt)
	fpsCount += 1
	if os.clock() - lastFpsTick >= 0.5 then
		local fps = math.floor(fpsCount / (os.clock() - lastFpsTick))
		UI.wmLabel.Text = string.format("GamePro • Lifetime • %d FPS", fps)
		fpsCount = 0
		lastFpsTick = os.clock()
	end

	RenderSmoothESP()

	if State.Fullbright then
		Svc.Lighting.Brightness = 2.5
		Svc.Lighting.GlobalShadows = false
		Svc.Lighting.Ambient = Color3.fromRGB(175, 175, 175)
	end

	-- 1. AIMBOT & SILENT AIM BERECHNUNG
	local aimTarget = FindBestCombatTarget(false)
	local silentTarget = State.SilentAim and FindBestCombatTarget(true) or nil
	local hudTarget = silentTarget or aimTarget

	if State.TargetHUD and hudTarget and not State.Streamproof then
		UI.targetHud.Visible = true
		local hum = hudTarget.Hum
		local dist = Env.CachedRoot and math.floor((hudTarget.Part.Position - Env.CachedRoot.Position).Magnitude / 3.2) or 0
		UI.thName.Text = "🎯 " .. hudTarget.Data.Name
		UI.thSub.Text = string.format("%d / %d HP • %dm", math.floor(hum.Health), math.floor(hum.MaxHealth), dist)
		UI.thBarFill.Size = UDim2.new(math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1), 0, 1, 0)
	else
		UI.targetHud.Visible = false
	end

	-- Silent Aim Line to Target
	if State.SilentAim and State.SilentDrawLine and silentTarget and not State.Streamproof then
		local vpCenter = camera.ViewportSize * 0.5
		SetLine(UI.silentTargetLine, vpCenter.X, vpCenter.Y, silentTarget.ScreenPos.X, silentTarget.ScreenPos.Y, State.SilentLineColor, 1.5)
	else
		UI.silentTargetLine.Visible = false
	end

	-- Silent Aim Snap (inkl. Hit Chance %)
	if State.SilentAim and silentTarget and Svc.UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
		if math.random(1, 100) <= State.SilentHitChance then
			camera.CFrame = CFrame.lookAt(camera.CFrame.Position, silentTarget.Position)
		end
	elseif State.AimAssist and aimTarget and (Svc.UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) or State.TargetLock) then
		if Env.LastTargetId ~= aimTarget.Data.Id then
			Env.LastTargetId = aimTarget.Data.Id
			Env.TargetAcquireTime = os.clock()
		end

		-- Reaction Time in ms berücksichtigen
		if (os.clock() - Env.TargetAcquireTime) * 1000 >= State.ReactionTime then
			local aimPos = aimTarget.Position

			if State.AimJitter then
				local j = State.JitterStrength * 0.015
				aimPos += Vector3.new((math.random() - 0.5) * j, (math.random() - 0.5) * j, 0)
			end
			if State.RandomOffset then
				aimPos += Vector3.new(math.sin(os.clock() * 4.5) * 0.09, math.cos(os.clock() * 3.5) * 0.09, 0)
			end
			if State.AimOvershoot then
				aimPos += Vector3.new(math.sin(os.clock() * 11) * 0.14, math.cos(os.clock() * 9) * 0.12, 0)
			end

			local distScale = 1
			if State.DistanceScaling and aimTarget.WorldDist then
				distScale = math.clamp(1 - (aimTarget.WorldDist / math.max(State.MaxAimDistance, 1)) * 0.35, 0.4, 1)
			end

			local gFactor = (105 - State.GlobalSmooth) / 100
			local alphaX = math.clamp(((105 - State.HorizontalSmooth) / 100) * gFactor * distScale, 0.03, 1)
			local alphaY = math.clamp(((105 - State.VerticalSmooth) / 100) * gFactor * distScale, 0.03, 1)
			local combinedAlpha = (alphaX + alphaY) * 0.5

			if State.AimCurve == "Smooth Smoothing" then
				combinedAlpha = combinedAlpha * combinedAlpha * (3 - 2 * combinedAlpha)
			elseif State.AimCurve == "Natural Smoothing" then
				combinedAlpha = math.sin(combinedAlpha * math.pi * 0.5)
			end

			local goalCFrame = CFrame.lookAt(camera.CFrame.Position, aimPos)
			camera.CFrame = camera.CFrame:Lerp(goalCFrame, math.clamp(combinedAlpha, 0.02, 1))
		end
	else
		Env.LastTargetId = nil
	end

	-- 2. TRIGGERBOT BERECHNUNG (MIT HITBOX- & FOV-PRÜFUNG)
	if State.Triggerbot and mouse.Target and (os.clock() - lastTriggerShot > (State.TriggerDelay / 1000)) then
		local hitPart = mouse.Target
		for _, t in ipairs(GetAllEntities()) do
			if hitPart:IsDescendantOf(t.Char) then
				local hum = t.Char:FindFirstChildOfClass("Humanoid")
				local hrp = t.Char:FindFirstChild("HumanoidRootPart")
				local head = t.Char:FindFirstChild("Head")
				if hum and hrp then
					if (t.IsNPC and not State.TriggerFilterNPC) or (not t.IsNPC and not State.TriggerFilterPlayers) then break end
					if t.IsFriend and not State.TriggerFilterFriends then break end
					if State.TriggerIgnoreDead and hum.Health <= 0 then break end
					if State.TriggerIgnoreInvisible and head and head.Transparency > 0.85 then break end

					local dist = (hrp.Position - camera.CFrame.Position).Magnitude / 3.2
					if dist <= State.TriggerMaxDistance then
						local pName = hitPart.Name
						local validBone = State.TriggerHitFullBody
							or (State.TriggerHitHead and pName == "Head")
							or (State.TriggerHitNeck and pName == "UpperTorso")
							or (State.TriggerHitUpperBody and (pName == "UpperTorso" or pName == "Torso" or pName == "HumanoidRootPart"))
							or (State.TriggerHitLowerBody and (pName == "LowerTorso" or string.find(pName, "Leg")))

						if validBone then
							lastTriggerShot = os.clock()
							pcall(function()
								Svc.VUser:Button1Down(Vector2.zero, camera.CFrame)
								task.delay(0.02, function() Svc.VUser:Button1Up(Vector2.zero, camera.CFrame) end)
							end)
						end
					end
				end
				break
			end
		end
	end

	-- 3. FULL-SPEC RADAR ENGINE
	UI.radarDotsFolder:ClearAllChildren()
	if State.ShowRadar and not State.Streamproof and Env.CachedRoot then
		local effRange = math.max(15, State.RadarRange / math.max(State.RadarZoom, 0.2))
		for _, t in ipairs(GetAllEntities()) do
			if t.Char == Env.CachedChar then continue end
			if (t.IsNPC and not State.RadarShowNPC) or (not t.IsNPC and not State.RadarShowPlayers) then continue end
			local hrp = t.Char:FindFirstChild("HumanoidRootPart")
			local hum = t.Char:FindFirstChildOfClass("Humanoid")
			if hrp and hum and (hum.Health > 0 or State.RadarShowDead) then
				local rel = camera.CFrame:PointToObjectSpace(hrp.Position)
				local distM = math.floor(rel.Magnitude / 3.2)
				local rx = math.clamp((rel.X / 3.2) / effRange * 0.45, -0.46, 0.46)
				local rz = math.clamp((rel.Z / 3.2) / effRange * 0.45, -0.46, 0.46)

				local dot = Instance.new("Frame", UI.radarDotsFolder)
				dot.Size = UDim2.new(0, 6, 0, 6)
				dot.AnchorPoint = Vector2.new(0.5, 0.5)
				dot.Position = UDim2.new(0.5 + rx, 0, 0.5 + rz, 0)
				dot.BackgroundColor3 = (hum.Health <= 0) and Color3.fromRGB(130, 130, 130) or (t.TeamColor or Colors.Accent)
				corner(dot, 3)

				if State.RadarShowNames or State.RadarShowDistance then
					local rLbl = Instance.new("TextLabel", dot)
					rLbl.Size = UDim2.new(0, 90, 0, 12)
					rLbl.Position = UDim2.new(0, 8, 0.5, -6)
					rLbl.BackgroundTransparency = 1
					rLbl.Font = Enum.Font.GothamBold
					rLbl.TextSize = 8
					rLbl.TextColor3 = Colors.TextMain
					rLbl.TextXAlignment = Enum.TextXAlignment.Left
					local parts = {}
					if State.RadarShowNames then table.insert(parts, t.Name) end
					if State.RadarShowDistance then table.insert(parts, distM .. "m") end
					rLbl.Text = table.concat(parts, " ")
				end
			end
		end
	end

	if State.Freecam then
		local moveVec = Vector3.zero
		if Svc.UIS:IsKeyDown(Enum.KeyCode.W) then moveVec += camera.CFrame.LookVector end
		if Svc.UIS:IsKeyDown(Enum.KeyCode.S) then moveVec -= camera.CFrame.LookVector end
		if Svc.UIS:IsKeyDown(Enum.KeyCode.A) then moveVec -= camera.CFrame.RightVector end
		if Svc.UIS:IsKeyDown(Enum.KeyCode.D) then moveVec += camera.CFrame.RightVector end
		if Svc.UIS:IsKeyDown(Enum.KeyCode.Space) then moveVec += Vector3.new(0, 1, 0) end
		if Svc.UIS:IsKeyDown(Enum.KeyCode.LeftShift) then moveVec -= Vector3.new(0, 1, 0) end
		local basePos = (Env.freecamCF or camera.CFrame).Position + (moveVec * State.FreecamSpeed * dt)
		Env.freecamCF = CFrame.lookAt(basePos, basePos + camera.CFrame.LookVector)
		camera.CFrame = Env.freecamCF
		return
	end

	if not (Env.CachedHum and Env.CachedRoot) then return end

	if State.GodMode and Env.CachedHum.Health < Env.CachedHum.MaxHealth then
		Env.CachedHum.Health = Env.CachedHum.MaxHealth
	end

	local targetRoot = getTargetRoot()
	if targetRoot then
		if State.OrbitTarget then
			orbitAngle += dt * State.OrbitSpeed
			local offset = Vector3.new(math.cos(orbitAngle) * State.OrbitRadius, 1, math.sin(orbitAngle) * State.OrbitRadius)
			Env.CachedRoot.CFrame = CFrame.lookAt(targetRoot.Position + offset, targetRoot.Position)
		elseif State.HeadSit then
			Env.CachedHum.Sit = true
			Env.CachedRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 2.7, 0)
		elseif State.FlingActive then
			for i = 1, #Env.CachedParts do if Env.CachedParts[i] then Env.CachedParts[i].CanCollide = false end end
			Env.CachedRoot.CFrame = targetRoot.CFrame
			Env.CachedRoot.AssemblyAngularVelocity = Vector3.new(0, 9500, 0)
		elseif State.BlackholeActive then
			targetRoot.CFrame = Env.CachedRoot.CFrame * CFrame.new(0, 0, -5)
		end
	end

	if State.Spinbot and not State.FlingActive then
		Env.CachedRoot.CFrame = Env.CachedRoot.CFrame * CFrame.Angles(0, math.rad(State.SpinSpeed), 0)
	end

	Env.CachedHum.WalkSpeed = State.WalkSpeed
	Env.CachedHum.UseJumpPower = true
	if not State.VehLockInside then Env.CachedHum.JumpPower = State.JumpPower end

	if State.AutoBhop and Svc.UIS:IsKeyDown(Enum.KeyCode.Space) and Env.CachedHum.FloorMaterial ~= Enum.Material.Air then
		Env.CachedHum.Jump = true
	end

	if (State.VehAccelMod or State.VehHornBoost) and Env.CachedHum.SeatPart and Env.CachedHum.SeatPart:IsA("VehicleSeat") then
		if (State.VehAccelMod and Svc.UIS:IsKeyDown(Enum.KeyCode.W)) or (State.VehHornBoost and Svc.UIS:IsKeyDown(Enum.KeyCode.E)) then
			Env.CachedHum.SeatPart.AssemblyLinearVelocity = camera.CFrame.LookVector * State.VehAccelVal
		end
	end

	if State.Noclip then
		for i = 1, #Env.CachedParts do
			local p = Env.CachedParts[i]
			if p and p.CanCollide then p.CanCollide = false end
		end
	end

	if State.Fly then
		Env.CachedHum.PlatformStand = true
		if not Env.flyAtt or Env.flyAtt.Parent ~= Env.CachedRoot then
			cleanupFlyConstraints()
			Env.flyAtt = Instance.new("Attachment", Env.CachedRoot) Env.flyAtt.Name = "GameProFlyAtt"
			Env.flyLv = Instance.new("LinearVelocity", Env.CachedRoot) Env.flyLv.Name = "GameProFlyLV"
			Env.flyLv.Attachment0 = Env.flyAtt Env.flyLv.MaxForce = math.huge
			Env.flyLv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector Env.flyLv.RelativeTo = Enum.ActuatorRelativeTo.World
			Env.flyAo = Instance.new("AlignOrientation", Env.CachedRoot) Env.flyAo.Name = "GameProFlyAO"
			Env.flyAo.Mode = Enum.OrientationAlignmentMode.OneAttachment Env.flyAo.Attachment0 = Env.flyAtt
			Env.flyAo.MaxTorque = math.huge Env.flyAo.Responsiveness = 50
		end

		local md = Vector3.zero
		if Svc.UIS:IsKeyDown(Enum.KeyCode.W) then md += camera.CFrame.LookVector end
		if Svc.UIS:IsKeyDown(Enum.KeyCode.S) then md -= camera.CFrame.LookVector end
		if Svc.UIS:IsKeyDown(Enum.KeyCode.A) then md -= camera.CFrame.RightVector end
		if Svc.UIS:IsKeyDown(Enum.KeyCode.D) then md += camera.CFrame.RightVector end
		if Svc.UIS:IsKeyDown(Enum.KeyCode.Space) then md += Vector3.new(0, 1, 0) end
		if Svc.UIS:IsKeyDown(Enum.KeyCode.LeftShift) then md -= Vector3.new(0, 1, 0) end

		Env.flyLv.VectorVelocity = md.Magnitude > 0 and (md.Unit * State.FlySpeed) or Vector3.zero
		Env.flyAo.CFrame = camera.CFrame
	else
		if Env.flyLv or Env.flyAo or Env.flyAtt then cleanupFlyConstraints() end
	end
end))

